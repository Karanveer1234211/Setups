//@version=6
indicator("BigMove | Top 5 Feature Lab", shorttitle="BM Top5", overlay=false, precision=2)

// RESEARCH VISUALIZATION, NOT ENGINE D AND NOT A TRADING STRATEGY.
// Definitions translated from frozenupdated/features_daily.py.
// Use a STANDARD, unadjusted 1D NSE equity chart with history from 2015-01-01.
// Different volume/price adjustments or insufficient historical bars can change values.

// --- Controls --------------------------------------------------------------
int normLen      = input.int(126, "Standardization window (sessions)", minval=30, maxval=504)
bool showParts   = input.bool(true, "Show five normalized component lines")
bool showCrosses = input.bool(false, "Mark composite zero-crosses (unvalidated)")
bool showTable   = input.bool(true, "Show live feature dashboard")

bool isDaily = timeframe.isdaily and timeframe.multiplier == 1
if not isDaily
    runtime.error("BigMove features are DAILY: switch chart timeframe to 1D.")

int startTime = timestamp("Asia/Kolkata", 2015, 1, 1, 0, 0)
bool anchored = time >= startTime
bool closedBar = barstate.isconfirmed

// Exact pandas-style expanding percentile rank with average ties.
// Applies to this stock's full history since 2015-01-01 (minimum 60 valid bars).
// Each call site has its own sorted history; only confirmed bars are inserted.
f_expandingRank(float x, bool useBar) =>
    var array<float> sorted = array.new_float()
    float rankPct = na
    if useBar and not na(x)
        int n = array.size(sorted)
        int lo = 0
        int hi = n
        // First index with value >= x.
        while lo < hi
            int mid = int(math.floor((lo + hi) / 2))
            if array.get(sorted, mid) < x
                lo := mid + 1
            else
                hi := mid
        int left = lo
        lo := left
        hi := n
        // First index with value > x.
        while lo < hi
            int mid = int(math.floor((lo + hi) / 2))
            if array.get(sorted, mid) <= x
                lo := mid + 1
            else
                hi := mid
        int right = lo
        // Pandas rank(pct=True): (number strictly below + average tie rank) / N.
        array.insert(sorted, right, x)
        int count = n + 1
        rankPct := count >= 60 ? (left + (right - left + 2) / 2.0) / count : na
    rankPct

// Exponential smoothing that matches pandas ewm(alpha=1/period, adjust=False,
// min_periods=period). It differs slightly from ta.rma() during its seed period.
f_ewmWilder(float x, int period) =>
    var float state = na
    var int obs = 0
    if not na(x)
        state := na(state) ? x : state + (x - state) / period
        obs := obs + 1
    obs >= period ? state : na

f_z(float x, int n) =>
    float avg = ta.sma(x, n)
    float sd = ta.stdev(x, n)
    not na(sd) and sd > 0 ? (x - avg) / sd : na

f_num(float x) =>
    na(x) ? "—" : str.tostring(x, "#.####")

f_row(table t, int r, string title, float raw, float z, color c) =>
    color bg = r % 2 == 0 ? color.new(color.gray, 87) : color.new(color.gray, 93)
    table.cell(t, 0, r, title, text_color=c, bgcolor=bg, text_halign=text.align_left)
    table.cell(t, 1, r, f_num(raw), text_color=chart.fg_color, bgcolor=bg)
    table.cell(t, 2, r, f_num(z), text_color=chart.fg_color, bgcolor=bg)
    table.cell(t, 3, r, na(z) ? "—" : z >= 0 ? "Above avg" : "Below avg", text_color=chart.fg_color, bgcolor=bg)

// --- Original five daily features -----------------------------------------
// 1) D_WQ_44 = -rolling_corr(high, expanding_rank(volume), 5).
float volumeRank = f_expandingRank(volume, anchored and closedBar)
float wq44 = closedBar ? -ta.correlation(high, volumeRank, 5) : na

// 2) D_mdi14_diff1 = -DI(14)[t] - -DI(14)[t-1].
float upMove = high - high[1]
float downMove = low[1] - low
float minusDM = anchored and anchored[1] and not na(upMove) and not na(downMove) and downMove > upMove and downMove > 0 ? downMove : 0.0
float tr = not anchored[1] or na(close[1]) ? high - low : math.max(high - low, math.max(math.abs(high - close[1]), math.abs(low - close[1])))
float smTR = f_ewmWilder(anchored ? tr : na, 14)
float smMinusDM = f_ewmWilder(anchored ? minusDM : na, 14)
float mdi14 = not na(smTR) and smTR > 0 ? 100.0 * smMinusDM / smTR : na
float mdiDiff = closedBar ? mdi14 - mdi14[1] : na

// 3) D_WQ_33 = expanding_rank(-1 + open / close).
float intradayWeakness = close != 0 ? open / close - 1.0 : na
float wq33 = f_expandingRank(intradayWeakness, anchored and closedBar)

// 4) D_rsi14_obv_x = RSI14 * delta(OBV).
// The code's delta(OBV) is sign(close change) * current volume.
float deltaC = close - close[1]
float gain = anchored and anchored[1] and not na(deltaC) ? math.max(deltaC, 0.0) : na
float loss = anchored and anchored[1] and not na(deltaC) ? math.max(-deltaC, 0.0) : na
float avgGain = f_ewmWilder(gain, 14)
float avgLoss = f_ewmWilder(loss, 14)
float rsi14 = na
if not na(avgGain) and not na(avgLoss)
    rsi14 := avgLoss == 0 ? (avgGain == 0 ? 50.0 : 100.0) : (avgGain == 0 ? 0.0 : 100.0 - 100.0 / (1.0 + avgGain / avgLoss))
float obvSlope = anchored and anchored[1] and not na(volume) and not na(deltaC) ? math.sign(deltaC) * volume : na
float rsiObv = closedBar ? rsi14 * obvSlope : na

// 5) D_WQ_12 = sign(volume[t] - volume[t-1]) * (close[t-1] - close[t]).
float wq12 = closedBar and anchored and anchored[1] and not na(volume) and not na(volume[1]) ? math.sign(volume - volume[1]) * (close[1] - close) : na

// --- A VISUAL DISPLAY, not a trained prediction ---------------------------
// Historical Stage B favoured higher values for all except D_rsi14_obv_x.
// Rolling z-scores remove differing units (price, volume, oscillator values).
float z44 = f_z(wq44, normLen)
float zMdi = f_z(mdiDiff, normLen)
float z33 = f_z(wq33, normLen)
float zRsiObv = -f_z(rsiObv, normLen)
float z12 = f_z(wq12, normLen)

bool ready = not na(z44) and not na(zMdi) and not na(z33) and not na(zRsiObv) and not na(z12)
float composite = ready ? (z44 + zMdi + z33 + zRsiObv + z12) / 5.0 : na
int confluence = ready ? (z44 > 0 ? 1 : 0) + (zMdi > 0 ? 1 : 0) + (z33 > 0 ? 1 : 0) + (zRsiObv > 0 ? 1 : 0) + (z12 > 0 ? 1 : 0) : 0

color c44 = color.aqua
color cMdi = color.orange
color c33 = color.lime
color cRsi = color.fuchsia
color c12 = color.purple

hline(0, "Neutral (relative to historical mean)", color=color.new(color.gray, 30))
hline(1, "+1 composite", color=color.new(color.gray, 80), linestyle=hline.style_dotted)
hline(-1, "-1 composite", color=color.new(color.gray, 80), linestyle=hline.style_dotted)
plot(showParts ? z44 : na, "WQ44 (positive direction)", color=color.new(c44, 30), linewidth=1)
plot(showParts ? zMdi : na, "MDI Δ1 (positive direction)", color=color.new(cMdi, 30), linewidth=1)
plot(showParts ? z33 : na, "WQ33 (positive direction)", color=color.new(c33, 30), linewidth=1)
plot(showParts ? zRsiObv : na, "RSI × OBV (inverted)", color=color.new(cRsi, 30), linewidth=1)
plot(showParts ? z12 : na, "WQ12 (positive direction)", color=color.new(c12, 30), linewidth=1)
plot(composite, "Equal-weight descriptive composite (NOT Engine D)", color=composite >= 0 ? color.teal : color.red, linewidth=3)

bool crossUp = ta.crossover(composite, 0)
bool crossDown = ta.crossunder(composite, 0)
plotshape(showCrosses and closedBar and crossUp ? 0 : na, title="Composite crossed above zero", style=shape.triangleup, location=location.absolute, color=color.teal, size=size.tiny)
plotshape(showCrosses and closedBar and crossDown ? 0 : na, title="Composite crossed below zero", style=shape.triangledown, location=location.absolute, color=color.red, size=size.tiny)
alertcondition(closedBar and crossUp, title="BM Top5 composite crossed ABOVE zero (research)", message="BigMove Top5 descriptive composite crossed above zero on {{ticker}} 1D. Not a validated trade signal.")
alertcondition(closedBar and crossDown, title="BM Top5 composite crossed BELOW zero (research)", message="BigMove Top5 descriptive composite crossed below zero on {{ticker}} 1D. Not a validated trade signal.")

// --- Dashboard -------------------------------------------------------------
var table dash = table.new(position.top_right, 4, 8, border_width=1, border_color=color.new(color.gray, 80))
if barstate.isfirst
    table.merge_cells(dash, 0, 7, 3, 7)
if barstate.islast and showTable
    color hb = color.new(color.blue, 60)
    table.cell(dash, 0, 0, "BigMove feature", text_color=color.white, bgcolor=hb)
    table.cell(dash, 1, 0, "Raw", text_color=color.white, bgcolor=hb)
    table.cell(dash, 2, 0, "Fav. z", text_color=color.white, bgcolor=hb)
    table.cell(dash, 3, 0, "vs history", text_color=color.white, bgcolor=hb)
    f_row(dash, 1, "WQ44", wq44, z44, c44)
    f_row(dash, 2, "MDI Δ1", mdiDiff, zMdi, cMdi)
    f_row(dash, 3, "WQ33", wq33, z33, c33)
    f_row(dash, 4, "RSI×OBV", rsiObv, zRsiObv, cRsi)
    f_row(dash, 5, "WQ12", wq12, z12, c12)
    color cb = color.new(color.gray, 78)
    table.cell(dash, 0, 6, "Composite", text_color=chart.fg_color, bgcolor=cb)
    table.cell(dash, 1, 6, "—", text_color=chart.fg_color, bgcolor=cb)
    table.cell(dash, 2, 6, f_num(composite), text_color=chart.fg_color, bgcolor=cb)
    table.cell(dash, 3, 6, ready ? str.tostring(confluence) + "/5 positive" : "Warming up", text_color=chart.fg_color, bgcolor=cb)
    string note = not closedBar ? "WAIT FOR DAILY CLOSE" : not ready ? "Need history since 2015 + warmup" : "RESEARCH ONLY • No tested trade rule"
    table.cell(dash, 0, 7, note, text_color=chart.fg_color, bgcolor=color.new(color.gray, 85), text_halign=text.align_left)

