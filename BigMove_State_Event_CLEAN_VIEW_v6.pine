//@version=6
indicator("BigMove State + Event | CLEAN VIEW (unverified classifier)", overlay=true, max_labels_count=150, max_lines_count=20)

// --- 1. ATR & MAs ---
atrLen  = input.int(14, "ATR Length", minval=1, group="1. ATR & MAs")
emaLen20  = input.int(20,  "EMA 20",  minval=1, group="1. ATR & MAs")
emaLen50  = input.int(50,  "EMA 50",  minval=1, group="1. ATR & MAs")
emaLen100 = input.int(100, "EMA 100", minval=1, group="1. ATR & MAs")
emaLen200 = input.int(200, "EMA 200", minval=1, group="1. ATR & MAs")

// --- 2. Structure ---
pivotLeft   = input.int(3, "Pivot Left Bars", minval=1, group="2. Structure")
pivotRight  = input.int(3, "Pivot Right Bars", minval=1, group="2. Structure")
structureAtrThresh = input.float(0.25, "Structure ATR Threshold", minval=0.0, step=0.05, group="2. Structure")
pivotScanLookback = input.int(50, "Swing Scan Lookback", minval=10, group="2. Structure")

// --- 3. State thresholds ---
effWindow      = input.int(20, "Efficiency Window", minval=2, group="3. State thresholds")
s03RangeAtr    = input.float(3.5, "S03 Range Cap (ATR)", minval=0.1, step=0.1, group="3. State thresholds")
s03EffCap      = input.float(0.30, "S03 Efficiency Cap", minval=0.0, step=0.05, group="3. State thresholds")
s07EffBand     = input.float(0.20, "S07 Efficiency Band", minval=0.0, step=0.05, group="3. State thresholds")
s07EmaChangeAtr = input.float(0.5, "S07 EMA50 Change (ATR)", minval=0.0, step=0.1, group="3. State thresholds")
s12VolRatio    = input.float(1.8, "S12 10/60 Vol Ratio", minval=0.1, step=0.1, group="3. State thresholds")
s12AtrPctRank  = input.float(95.0, "S12 ATR Percentile", minval=50.0, maxval=100.0, step=0.5, group="3. State thresholds")
s12RevCount    = input.int(3, "S12 Major Reversal Count", minval=1, group="3. State thresholds")
s12GapCount    = input.int(4, "S12 Large Gap Count", minval=1, group="3. State thresholds")
s12EffCap      = input.float(0.25, "S12 Efficiency Cap", minval=0.0, step=0.05, group="3. State thresholds")
prevTrendLookback = input.int(30, "Prev Lookback", minval=1, group="3. State thresholds")

// --- 4. Events ---
trapAtrThresh  = input.float(0.25, "Trap Threshold (ATR)", minval=0.0, step=0.05, group="4. Events")
trapWindow     = input.int(5, "Trap Window (Bars)", minval=1, group="4. Events")
overextAtr1    = input.float(3.0, "S05 EMA20 + ATR Mult", minval=0.0, step=0.5, group="4. Events")
overextAtr2    = input.float(6.0, "S05 EMA50 + ATR Mult", minval=0.0, step=0.5, group="4. Events")
overextRiseAtr = input.float(6.0, "S05 10-bar Rise (ATR)", minval=0.0, step=0.5, group="4. Events")
confirmBars    = input.int(3, "Event Confirmation Bars", minval=1, group="4. Events")
visibilityBars = input.int(10, "Visibility Bars", minval=1, group="4. Events")

// --- 5. Display ---
showBgTint     = input.bool(false, "Subtle background by CONFIRMED state", group="5. Display")
showStatusTbl  = input.bool(true, "Compact state / event dashboard", group="5. Display")
showEventMarks = input.bool(true, "Show one marker per NEW event", group="5. Display")
visibleLookback = input.int(180, "Only draw markers in last N bars", minval=20, maxval=3000, group="5. Display")
showTransitionLabels = input.bool(true, "Show labels on actual transitions", group="5. Display")
debugPlots     = input.bool(false, "Show Debug Plots", group="5. Display")

// --- 6. State markers ---
showStateDot   = input.bool(false, "Diagnostic: state dot every bar (clutter)", group="6. State markers")
showStateText  = input.bool(false, "Show state text on every bar (cluttered)", group="6. State markers")
showTransLabel = input.bool(false, "Legacy transition labels (superseded)", group="6. State markers")

stateFamilyColor(_st) =>
    _st == "S01" or _st == "S02" or _st == "S03" or _st == "S06" ? color.green : _st == "S08" or _st == "S09" ? color.red : _st == "S07" ? color.gray : _st == "S12" ? color.orange : na

// ---------------- CORE ----------------
atr = ta.atr(atrLen)
ema20 = ta.ema(close, emaLen20)
ema50 = ta.ema(close, emaLen50)
ema100 = ta.ema(close, emaLen100)
ema200 = ta.ema(close, emaLen200)
rsi14 = ta.rsi(close, 14)

closeDiffSum = math.sum(math.abs(close - close[1]), effWindow)
efficiency = (not na(close[effWindow]) and not na(closeDiffSum) and closeDiffSum != 0.0) ? (close - close[effWindow]) / closeDiffSum : na

ret = (not na(close[1]) and close[1] != 0.0) ? (close - close[1]) / close[1] : na
retStdev10 = ta.stdev(ret, 10)
retStdev60 = ta.stdev(ret, 60)
volRatio10_60 = (not na(retStdev10) and not na(retStdev60) and retStdev60 != 0.0) ? retStdev10 / retStdev60 : na
atrPct = close != 0.0 and not na(atr) ? (atr / close) * 100.0 : na
atrPctRank = ta.percentrank(atrPct, 250)

volSma5 = ta.sma(volume, 5)
volSma50 = ta.sma(volume, 50)
volFlowRatio = (not na(volSma5) and not na(volSma50) and volSma50 != 0.0) ? volSma5 / volSma50 : na

ph = ta.pivothigh(high, pivotLeft, pivotRight)
pl = ta.pivotlow(low, pivotLeft, pivotRight)

var float lastPivotHigh1 = na
var float lastPivotHigh2 = na
var float lastPivotLow1 = na
var float lastPivotLow2 = na
var int   lastPivotLowBar1 = na

if not na(ph)
    lastPivotHigh2 := lastPivotHigh1
    lastPivotHigh1 := ph
if not na(pl)
    lastPivotLow2 := lastPivotLow1
    lastPivotLow1 := pl
    lastPivotLowBar1 := bar_index - pivotRight

hhClass = na(lastPivotHigh1) or na(lastPivotHigh2) or na(atr) ? "NA" : math.abs(lastPivotHigh1 - lastPivotHigh2) < structureAtrThresh * atr ? "EQ" : lastPivotHigh1 > lastPivotHigh2 ? "HH" : "LH"
llClass = na(lastPivotLow1) or na(lastPivotLow2) or na(atr) ? "NA" : math.abs(lastPivotLow1 - lastPivotLow2) < structureAtrThresh * atr ? "EQ" : lastPivotLow1 > lastPivotLow2 ? "HL" : "LL"

isHH = hhClass == "HH"
isLH = hhClass == "LH"
isHL = llClass == "HL"
isLL = llClass == "LL"

ema50Rising = not na(ema50[10]) and ema50 > ema50[1] and ema50 > ema50[10]
ema50Falling = not na(ema50[10]) and ema50 < ema50[1] and ema50 < ema50[10]

noFreshLL10 = math.sum(isLL ? 1 : 0, 10) == 0
range15 = ta.highest(high, 15) - ta.lowest(low, 15)
recentHL = not na(lastPivotLowBar1) and (bar_index - lastPivotLowBar1) <= 10 and llClass == "HL"
rsiReversal = ta.lowest(rsi14, 15) < 30 and rsi14 > 45

hi10 = ta.highest(high, 10)
lo10 = ta.lowest(low, 10)
range10 = hi10 - lo10
closeTop33 = range10 > 0 ? close >= lo10 + 0.67 * range10 : false
reversal5 = closeTop33 and volFlowRatio >= 1.2

lowest5 = ta.lowest(low, 5)
lowest25 = ta.lowest(low, 25)
noFresh25Low = not na(lowest25[5]) ? lowest5 > lowest25[5] : false

threeBarDir = close - close[3]
threeBarDirPrev = close[1] - close[4]
dirSignChange = not na(threeBarDirPrev) and math.sign(threeBarDir) != math.sign(threeBarDirPrev)
majorReversalBar = dirSignChange and math.abs(threeBarDir) > 0.75 * atr
majorReversalCount20 = math.sum(majorReversalBar ? 1 : 0, 20)

openGap = not na(close[1]) ? math.abs(open - close[1]) : na
largeGapBar = not na(openGap) and openGap >= 0.5 * atr
largeGapCount10 = math.sum(largeGapBar ? 1 : 0, 10)
atrPctExtreme = not na(atrPctRank) and atrPctRank >= s12AtrPctRank

// ---------------- STATES (order matters) ----------------
s01 = not na(atr) and not na(efficiency) and isHH and isHL and close > ema50 and ema50Rising and close > ema200
s02 = not na(atr) and close > ema50 and ema50Rising and not s01
s08 = not na(atr) and isLH and isLL and close < ema50 and ema50Falling and close < ema200
s09 = not na(atr) and close < ema50 and ema50Falling and not s08

prevBullishRecent = math.sum((s01[1] or s02[1]) ? 1 : 0, prevTrendLookback) > 0
prevBearishRecent = math.sum((s08[1] or s09[1]) ? 1 : 0, prevTrendLookback) > 0

s03 = not na(atr) and prevBullishRecent and range15 <= s03RangeAtr * atr and math.abs(efficiency) < s03EffCap and close > ema100 and noFreshLL10
s07 = not na(atr) and not na(efficiency) and efficiency >= -s07EffBand and efficiency <= s07EffBand and math.abs(ema50 - ema50[10]) < s07EmaChangeAtr * atr
s12 = not na(atr) and not na(volRatio10_60) and (volRatio10_60 >= s12VolRatio or atrPctExtreme) and (majorReversalCount20 >= s12RevCount or largeGapCount10 >= s12GapCount) and math.abs(efficiency) < s12EffCap

aboveEma20 = close > ema20
heldEma20Two = aboveEma20 and aboveEma20[1]
wasBelowEma20 = not aboveEma20[3] or not aboveEma20[4] or not aboveEma20[5] or not aboveEma20[6] or not aboveEma20[7]
rev1 = heldEma20Two and wasBelowEma20
rev4raw = math.sum((close > ema50) ? 1 : 0, 10)
rev4 = close > ema50 and rev4raw == 1
revSignCount = (rev1 ? 1 : 0) + (recentHL ? 1 : 0) + (rsiReversal ? 1 : 0) + (rev4 ? 1 : 0) + (reversal5 ? 1 : 0)
s06 = not na(atr) and prevBearishRecent and revSignCount >= 2 and noFresh25Low

// ---------------- PRECEDENCE + CONFIRMATION ----------------
primaryCandidate = s12 ? "S12" : s06 ? "S06" : s01 ? "S01" : s08 ? "S08" : s03 ? "S03" : s07 ? "S07" : s02 ? "S02" : s09 ? "S09" : "INIT"

var string pendingState = "INIT"
var int pendingCount = 0
var string confirmedState = "INIT"
var int stateStartBar = na
// Capture the state at the START of this bar; comparing to a persistent
// previous-transition label was the cause of labels on every candle.
string stateBeforeUpdate = confirmedState

if s12
    pendingState := "S12"
    pendingCount := 1
    if confirmedState != "S12"
        confirmedState := "S12"
        stateStartBar := bar_index
else
    if primaryCandidate == pendingState
        pendingCount += 1
    else
        pendingState := primaryCandidate
        pendingCount := 1
    if pendingCount >= 2 and confirmedState != pendingState
        confirmedState := pendingState
        stateStartBar := bar_index

insufficientData = bar_index < math.max(emaLen200, math.max(effWindow, 60)) or na(atr) or na(efficiency) or na(volRatio10_60)
confirmedStateForDisplay = insufficientData ? "INIT" : confirmedState
daysInState = not na(stateStartBar) ? (bar_index - stateStartBar) : na
actualStateChange = (confirmedState != stateBeforeUpdate) and confirmedState != "INIT"
recentForDraw = bar_index >= last_bar_index - visibleLookback
confirmedDraw = barstate.isconfirmed and recentForDraw

// ---------------- EVENTS ----------------
rh55 = ta.highest(high[1], 55)
rl55 = ta.lowest(low[1], 55)
rh20 = ta.highest(high[1], 20)
rl20 = ta.lowest(low[1], 20)
breakLevel = na(rh55) ? rh20 : rh55
breakDnLevel = na(rl55) ? rl20 : rl55

s04raw = ta.crossover(close, breakLevel)
s10raw = ta.crossunder(close, breakDnLevel)
s04Fire = not na(breakLevel) and s04raw
s10Fire = not na(breakDnLevel) and s10raw

var float lastS04Level = na
var float lastS10Level = na
var int lastS04Bar = na
var int lastS10Bar = na

// Emit a failure event only once per originating breakout/breakdown.
var bool bullTrapAlreadyRecorded = false
var bool bearTrapAlreadyRecorded = false
var int lastBullTrapBar = na
var int lastBearTrapBar = na

if s04Fire
    lastS04Level := breakLevel
    lastS04Bar := bar_index
    bullTrapAlreadyRecorded := false
if s10Fire
    lastS10Level := breakDnLevel
    lastS10Bar := bar_index
    bearTrapAlreadyRecorded := false

bullTrapNow = not na(lastS04Bar) and (bar_index - lastS04Bar) <= trapWindow and not na(lastS04Level) and close < lastS04Level - trapAtrThresh * atr
bearTrapNow = not na(lastS10Bar) and (bar_index - lastS10Bar) <= trapWindow and not na(lastS10Level) and close > lastS10Level + trapAtrThresh * atr
bullTrapFire = bullTrapNow and not bullTrapAlreadyRecorded and barstate.isconfirmed
bearTrapFire = bearTrapNow and not bearTrapAlreadyRecorded and barstate.isconfirmed
if bullTrapFire
    bullTrapAlreadyRecorded := true
    lastBullTrapBar := bar_index
if bearTrapFire
    bearTrapAlreadyRecorded := true
    lastBearTrapBar := bar_index
s05Now = not na(atr) and (close >= ema20 + overextAtr1 * atr or close >= ema50 + overextAtr2 * atr or (not na(close[10]) and close - close[10] >= overextRiseAtr * atr))

// ---------------- CLEAN VISUALS ----------------
// IMPORTANT: Source formulas above are the uploaded draft, NOT verified tl_state parity.
// Only PRESENTATION and repeat-trigger/transition bookkeeping are repaired here.
stateShown = confirmedStateForDisplay
stateTint = stateFamilyColor(stateShown)
bgcolor(showBgTint and stateShown != "INIT" ? color.new(stateTint, 96) : na)

// Default = zero per-candle state dots; enable explicitly for debugging.
plotshape(showStateDot and confirmedDraw and (stateShown == "S01" or stateShown == "S02" or stateShown == "S03" or stateShown == "S06"), title="Bull dot (debug)", style=shape.circle, location=location.belowbar, color=color.new(color.green, 45), size=size.tiny)
plotshape(showStateDot and confirmedDraw and (stateShown == "S08" or stateShown == "S09"), title="Bear dot (debug)", style=shape.circle, location=location.belowbar, color=color.new(color.red, 45), size=size.tiny)
plotshape(showStateDot and confirmedDraw and stateShown == "S07", title="Range dot (debug)", style=shape.circle, location=location.belowbar, color=color.new(color.gray, 45), size=size.tiny)
plotshape(showStateDot and confirmedDraw and stateShown == "S12", title="Disorder dot (debug)", style=shape.circle, location=location.belowbar, color=color.new(color.orange, 45), size=size.tiny)

s05Onset = s05Now and not s05Now[1]
plotshape(showEventMarks and confirmedDraw and s04Fire, title="S04 breakout FIRE", style=shape.triangleup, location=location.belowbar, color=color.green, size=size.tiny, text="04")
plotshape(showEventMarks and confirmedDraw and s10Fire, title="S10 breakdown FIRE", style=shape.triangledown, location=location.abovebar, color=color.red, size=size.tiny, text="10")
plotshape(showEventMarks and confirmedDraw and bullTrapFire, title="S11 failed breakout FIRE", style=shape.xcross, location=location.abovebar, color=color.orange, size=size.tiny)
plotshape(showEventMarks and confirmedDraw and bearTrapFire, title="Failed breakdown FIRE", style=shape.xcross, location=location.belowbar, color=color.lime, size=size.tiny)
plotshape(showEventMarks and confirmedDraw and s05Onset, title="S05 overextension ONSET", style=shape.diamond, location=location.abovebar, color=color.yellow, size=size.tiny)

// Never draw a transition on every bar merely because the currently confirmed
// state differs from a state remembered at an earlier transition.
if showTransitionLabels and confirmedDraw and actualStateChange and not insufficientData
    label.new(bar_index, high, stateBeforeUpdate + "→" + confirmedState, style=label.style_label_down, color=stateTint, textcolor=color.white, size=size.tiny)

// Optional diagnostics in Data Window (not placed over candles).
plot(debugPlots ? efficiency : na, "Efficiency (diagnostic)", color=color.aqua, display=display.data_window)
plot(debugPlots ? atrPct : na, "ATR% (diagnostic)", color=color.fuchsia, display=display.data_window)
plot(debugPlots ? volRatio10_60 : na, "10/60 vol (diagnostic)", color=color.orange, display=display.data_window)

// Show newest event in a ten-session window. This is NOT a substitute for
// the official NEW / CONFIRMED / STALLED event-state machine.
string latestEvent = "None"
int latestEventBar = na
if not na(lastS04Bar) and bar_index - lastS04Bar <= visibilityBars
    latestEvent := "S04 Breakout"
    latestEventBar := lastS04Bar
if not na(lastS10Bar) and bar_index - lastS10Bar <= visibilityBars and (na(latestEventBar) or lastS10Bar >= latestEventBar)
    latestEvent := "S10 Breakdown"
    latestEventBar := lastS10Bar
if not na(lastBullTrapBar) and bar_index - lastBullTrapBar <= visibilityBars and (na(latestEventBar) or lastBullTrapBar >= latestEventBar)
    latestEvent := "S11 Bull trap"
    latestEventBar := lastBullTrapBar
if not na(lastBearTrapBar) and bar_index - lastBearTrapBar <= visibilityBars and (na(latestEventBar) or lastBearTrapBar >= latestEventBar)
    latestEvent := "Failed breakdown"
    latestEventBar := lastBearTrapBar

var table dashboard = table.new(position.top_right, 2, 8, border_width=1, frame_color=color.new(color.gray, 65), border_color=color.new(color.gray, 75))
if barstate.islast
    if showStatusTbl
        table.cell(dashboard, 0, 0, "BIGMOVE • DRAFT", text_color=color.white, bgcolor=color.new(color.silver, 70), text_size=size.small)
        table.cell(dashboard, 1, 0, "1D ONLY", text_color=color.white, bgcolor=color.new(color.silver, 70), text_size=size.small)
        table.cell(dashboard, 0, 1, "State", text_color=color.silver, text_size=size.small)
        table.cell(dashboard, 1, 1, stateShown, text_color=color.white, bgcolor=color.new(stateTint, 70), text_size=size.small)
        table.cell(dashboard, 0, 2, "State age", text_color=color.silver, text_size=size.small)
        table.cell(dashboard, 1, 2, na(daysInState) ? "-" : str.tostring(daysInState), text_color=color.white, text_size=size.small)
        table.cell(dashboard, 0, 3, "Latest event", text_color=color.silver, text_size=size.small)
        table.cell(dashboard, 1, 3, latestEvent, text_color=color.white, text_size=size.small)
        table.cell(dashboard, 0, 4, "Event age", text_color=color.silver, text_size=size.small)
        table.cell(dashboard, 1, 4, na(latestEventBar) ? "-" : str.tostring(bar_index - latestEventBar), text_color=color.white, text_size=size.small)
        table.cell(dashboard, 0, 5, "S05 overextended", text_color=color.silver, text_size=size.small)
        table.cell(dashboard, 1, 5, s05Now ? "YES" : "No", text_color=s05Now ? color.yellow : color.white, text_size=size.small)
        table.cell(dashboard, 0, 6, "Structure", text_color=color.silver, text_size=size.small)
        table.cell(dashboard, 1, 6, hhClass + " / " + llClass, text_color=color.white, text_size=size.small)
        table.cell(dashboard, 0, 7, "Accuracy", text_color=color.yellow, text_size=size.small)
        table.cell(dashboard, 1, 7, timeframe.isdaily ? "NOT JOURNAL-VERIFIED" : "USE DAILY CHART", text_color=color.yellow, text_size=size.tiny)
    else
        table.clear(dashboard, 0, 0, 1, 7)

alertcondition(actualStateChange and barstate.isconfirmed and not insufficientData, title="Confirmed state changed", message="BigMove draft state changed")
alertcondition(s04Fire and barstate.isconfirmed, title="S04 breakout", message="S04 breakout")
alertcondition(s10Fire and barstate.isconfirmed, title="S10 breakdown", message="S10 breakdown")
alertcondition(bullTrapFire, title="S11 bull trap", message="S11 failed breakout")
alertcondition(bearTrapFire, title="Bear trap", message="Failed breakdown")
alertcondition(s05Onset and barstate.isconfirmed, title="S05 onset", message="S05 overextension onset")
