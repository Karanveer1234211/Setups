//@version=5
// =====================================================================================================================
// BigMove_Playbook.pine - playbook v1.0 (BMPB1)
// One strategy, one playbook per state + event category, the open entry beside every trade.
//
// A pick's category = tl_state's state and shown event at its close T (plus the market regime), from the export
// (python playbook.py export). The MAPPING sends each category to one of six PLAYBOOKS (first matching rule wins).
// A playbook = an entry rule + an exit rule. Every field is a setting below; the same fields, with the same defaults
// and the same order of events, are in pb_core.py, so 'python playbook.py sim --code <code>' runs exactly these rules
// on every pick (the code is in the audit table and in the first Pine Logs line).
//
// Entry (orders are placed at a close and act from the next session; ATR = ta.atr(14)):
//   OPEN   market at T+1's open (G > 0: a limit at T's close x (1 + G%) for T+1 only)
//   DELAY  market at the open of T+1+V
//   STH    buy stop at T's high + O x ATR(T), sessions T+1 .. T+V (stop-limit: + L x ATR; L = 0: plain stop)
//   STPD   buy stop at the previous session's high + O x ATR, re-set every evening, T+1 .. T+V
//   STLV   buy stop at the event level + O x ATR(T) (reclaim of a failed breakout / breakdown level)
//   LMLV   limit at the event level + O x ATR(T) (retest of the breakout level)
//   LMTC   limit at T's close - O x ATR(T) (pullback)
//   LMEMA  limit at EMA20 + O x ATR, re-set every evening
//   SKIP   no trade
//   A buy stop whose trigger is at or below the last close is not placed (at T) or is cancelled (later).
//   F = OPEN: if nothing filled in the window (or no order could be placed), market at the next open.
// Exit: stop S (NONE / ATR: entry - SK x ATR at the entry close / PCT / TLOW: T's low - SK x ATR(T) / LVL: level -
//   SK x ATR(T)), target T (NONE / R: entry + TK x risk / PCT), hold H sessions from the entry session (X = OPEN:
//   sell at the next open, H = 5 from a T+1 entry = OPEN6; X = CLOSE: sell at that close = PLAN), trail TR (after a
//   completed close above entry x (1 + TA%): stop to entry + both commissions, then TM x ATR under the highest close,
//   never down; EX > H holds a trailed trade up to EX sessions). Stops and targets are placed at the entry session's
//   close: the entry session itself has no stop.
// Keep Properties as shipped: commission 0.175% (= the setting below), no slippage, bar magnifier OFF, 'recalculate
// after order is filled' OFF. With the magnifier on, TradingView uses intrabar data and a stop and a target inside one
// bar may resolve differently from pb_core's path rule (open -> nearer extreme -> other extreme -> close).
// =====================================================================================================================
strategy("BigMove Playbook v1.0", shorttitle="BMPB", overlay=true, pyramiding=100, initial_capital=10000000000,
  default_qty_type=strategy.cash, default_qty_value=10000000, commission_type=strategy.commission.percent,
  commission_value=0.175, slippage=0, close_entries_rule="ANY", margin_long=100, margin_short=100,
  max_labels_count=500, max_lines_count=500, calc_on_every_tick=false, process_orders_on_close=false,
  calc_on_order_fills=false, use_bar_magnifier=false)

VERSION = "playbook v1.0"
TAG = "BMPB1"
STATES = ",S01,S02,S03,S06,S07,S08,S09,S12,UNK,INS,"
EVENTS = ",BO_NEW,BO_CONF,BO_STALL,FBO,BD_NEW,BD_CONF,BD_STALL,FBD,NONE,"
REGIMES = ",BB,NB,MX,BR,HS,NA,"
DEFAULT_CODE = "BMPB1|C=0.175|M=S01,S02,S03:BO_NEW,BO_CONF:*=P2;*:FBO:*=P3;*:BD_NEW,BD_CONF:*=P4;S06,S07,S08,S09,S12:FBD,NONE,BO_STALL,BD_STALL:*=P5;*:*:*=P1|P1=E:OPEN,O:0,V:1,L:0.3,G:0,F:NONE,S:NONE,SK:0,T:NONE,TK:0,H:5,X:OPEN,TR:0,TA:3,TM:2,EX:0|P2=E:LMLV,O:0.25,V:5,L:0.3,G:0,F:NONE,S:NONE,SK:0,T:NONE,TK:0,H:5,X:OPEN,TR:0,TA:3,TM:2,EX:0|P3=E:STLV,O:0.1,V:10,L:0.3,G:0,F:NONE,S:NONE,SK:0,T:NONE,TK:0,H:5,X:OPEN,TR:0,TA:3,TM:2,EX:0|P4=E:STLV,O:0.25,V:5,L:0.3,G:0,F:NONE,S:NONE,SK:0,T:NONE,TK:0,H:5,X:OPEN,TR:0,TA:3,TM:2,EX:0|P5=E:STH,O:0.1,V:10,L:0.3,G:0,F:NONE,S:NONE,SK:0,T:NONE,TK:0,H:5,X:OPEN,TR:0,TA:3,TM:2,EX:0|P6=E:LMTC,O:1,V:3,L:0.3,G:0,F:NONE,S:NONE,SK:0,T:NONE,TK:0,H:5,X:OPEN,TR:0,TA:3,TM:2,EX:0"

// ============================================================================================================ inputs
G_P = "1. Picks (from playbook.py export)"
iPicks = input.text_area("", "Picks", tooltip="Paste a whole export file: pine/SYMBOL.txt (this stock, header #BMPB1|SYMBOL|...) or pine_by_category/STATE_EVENT.txt (one category, every stock, header #BMPB1|*|...: paste once, then change the chart's symbol). One pick per line: trade id, state, event, event age, regime, level / T close, T close, OPEN6 gross, PLAN5 gross, TradingView ticker. Lines of other tickers are skipped.", group=G_P, display=display.none)
iTk = input.string("", "Ticker in the file (blank = this chart's)", tooltip="Only if TradingView's ticker for this stock differs from the export's name (the export writes the NSE name with & and - as _). The audit table shows both.", group=G_P, display=display.none)
iFind = input.text_area("", "Findings", tooltip="Your findings, one per line: trade id|verdict|note   e.g.  D-20220314-1|BETTER|retest held at the level. Verdicts BETTER / WORSE / SAME are counted per category; the note shows on the pick.", group=G_P, display=display.none)

G_W = "2. Which picks and what the strategy trades"
iEng = input.string("ALL", "Engine", options=["ALL", "D", "ENS"], group=G_W, inline="w1", display=display.none)
iMaxRank = input.int(3, "Max rank", minval=1, maxval=10, group=G_W, inline="w1", display=display.none)
iFrom = input.int(20200101, "From yyyymmdd", group=G_W, inline="w2", display=display.none)
iTo = input.int(20221231, "To yyyymmdd", group=G_W, inline="w2", display=display.none)
iSt = input.string("ALL", "State", options=["ALL", "S01", "S02", "S03", "S06", "S07", "S08", "S09", "S12", "UNK", "INS"], group=G_W, inline="w3", display=display.none)
iEv = input.string("ALL", "Event", options=["ALL", "BO_NEW", "BO_CONF", "BO_STALL", "FBO", "BD_NEW", "BD_CONF", "BD_STALL", "FBD", "NONE"], group=G_W, inline="w3", display=display.none)
iRg = input.string("ALL", "Regime", options=["ALL", "BB", "NB", "MX", "BR", "HS", "NA"], group=G_W, inline="w4", display=display.none)
iForce = input.string("Mapping", "Playbook", options=["Mapping", "P1", "P2", "P3", "P4", "P5", "P6"], tooltip="Mapping = each category's playbook from the mapping below; P1 .. P6 = that playbook on every pick shown (sim: --force Pn).", group=G_W, inline="w4", display=display.none)
iTrades = input.string("Playbook", "Strategy trades", options=["Playbook", "OPEN6 baseline", "Both"], tooltip="What the Strategy Tester's trades are: the playbook's (trade id = the pick's id), the open entry (B~id: T+1 open to T+6 open), or both. The tables always show both from the chart's bars.", group=G_W, display=display.none)

G_D = "3. Review"
iFocus = input.int(0, "Focus pick # (0 = none)", minval=0, group=G_D, inline="d1", display=display.none)
iFocusId = input.string("", "or trade id", group=G_D, inline="d1", display=display.none)
iPage = input.int(1, "Pick list page (0 = hide)", minval=0, group=G_D, inline="d2", display=display.none)
iRows = input.int(20, "rows", minval=5, maxval=40, group=G_D, inline="d2", display=display.none)
iShowSum = input.bool(true, "Category table", group=G_D, inline="d3", display=display.none)
iShowAud = input.bool(true, "Audit table", group=G_D, inline="d3", display=display.none)
iLabels = input.bool(true, "Pick labels", group=G_D, inline="d4", display=display.none)
iLog = input.bool(true, "Pine Logs", group=G_D, inline="d4", display=display.none)
iTxt = input.string("small", "Text", options=["tiny", "small", "normal"], group=G_D, inline="d4", display=display.none)

G_M = "4. Mapping and cost"
iMap = input.text_area("S01,S02,S03:BO_NEW,BO_CONF:*=P2;*:FBO:*=P3;*:BD_NEW,BD_CONF:*=P4;S06,S07,S08,S09,S12:FBD,NONE,BO_STALL,BD_STALL:*=P5;*:*:*=P1", "Mapping", tooltip="Rules STATE:EVENT[:REGIME]=Pn separated by ; or new lines, first match wins, * = any, lists with commas. States S01 S02 S03 S06 S07 S08 S09 S12 UNK INS; events BO_NEW BO_CONF BO_STALL FBO BD_NEW BD_CONF BD_STALL FBD NONE; regimes BB NB MX BR HS NA. No rule matches -> P1.", group=G_M, display=display.none)
iComm = input.float(0.175, "Commission % per side", minval=0.0, step=0.005, tooltip="Used for the tables and the config code. Keep it equal to Properties > Commission (shipped 0.175).", group=G_M, display=display.none)

G1 = "P1 playbook"
p1N = input.string("Open T+1 (baseline)", "P1 title", group=G1, display=display.none)
p1E = input.string("OPEN", "Entry", options=["OPEN", "DELAY", "STH", "STPD", "STLV", "LMLV", "LMTC", "LMEMA", "SKIP"], group=G1, inline="1a", display=display.none)
p1O = input.float(0.0, "O xATR", step=0.05, group=G1, inline="1a", display=display.none)
p1V = input.int(1, "V", minval=1, maxval=60, group=G1, inline="1a", display=display.none)
p1L = input.float(0.3, "L xATR", minval=0.0, step=0.05, group=G1, inline="1b", display=display.none)
p1G = input.float(0.0, "G %", minval=0.0, step=0.25, group=G1, inline="1b", display=display.none)
p1F = input.string("NONE", "Fallback", options=["NONE", "OPEN"], group=G1, inline="1b", display=display.none)
p1S = input.string("NONE", "Stop", options=["NONE", "ATR", "PCT", "TLOW", "LVL"], group=G1, inline="1c", display=display.none)
p1SK = input.float(0.0, "SK", step=0.25, group=G1, inline="1c", display=display.none)
p1T = input.string("NONE", "Target", options=["NONE", "R", "PCT"], group=G1, inline="1c", display=display.none)
p1TK = input.float(0.0, "TK", step=0.25, group=G1, inline="1c", display=display.none)
p1H = input.int(5, "Hold H", minval=1, maxval=250, group=G1, inline="1d", display=display.none)
p1X = input.string("OPEN", "sell at", options=["OPEN", "CLOSE"], group=G1, inline="1d", display=display.none)
p1TR = input.bool(false, "Trail", group=G1, inline="1e", display=display.none)
p1TA = input.float(3.0, "arm %", step=0.5, group=G1, inline="1e", display=display.none)
p1TM = input.float(2.0, "xATR", step=0.25, group=G1, inline="1e", display=display.none)
p1EX = input.int(0, "max hold", minval=0, maxval=250, group=G1, inline="1e", display=display.none)

G2 = "P2 playbook"
p2N = input.string("Breakout retest: limit at the breakout level", "P2 title", group=G2, display=display.none)
p2E = input.string("LMLV", "Entry", options=["OPEN", "DELAY", "STH", "STPD", "STLV", "LMLV", "LMTC", "LMEMA", "SKIP"], group=G2, inline="2a", display=display.none)
p2O = input.float(0.25, "O xATR", step=0.05, group=G2, inline="2a", display=display.none)
p2V = input.int(5, "V", minval=1, maxval=60, group=G2, inline="2a", display=display.none)
p2L = input.float(0.3, "L xATR", minval=0.0, step=0.05, group=G2, inline="2b", display=display.none)
p2G = input.float(0.0, "G %", minval=0.0, step=0.25, group=G2, inline="2b", display=display.none)
p2F = input.string("NONE", "Fallback", options=["NONE", "OPEN"], group=G2, inline="2b", display=display.none)
p2S = input.string("NONE", "Stop", options=["NONE", "ATR", "PCT", "TLOW", "LVL"], group=G2, inline="2c", display=display.none)
p2SK = input.float(0.0, "SK", step=0.25, group=G2, inline="2c", display=display.none)
p2T = input.string("NONE", "Target", options=["NONE", "R", "PCT"], group=G2, inline="2c", display=display.none)
p2TK = input.float(0.0, "TK", step=0.25, group=G2, inline="2c", display=display.none)
p2H = input.int(5, "Hold H", minval=1, maxval=250, group=G2, inline="2d", display=display.none)
p2X = input.string("OPEN", "sell at", options=["OPEN", "CLOSE"], group=G2, inline="2d", display=display.none)
p2TR = input.bool(false, "Trail", group=G2, inline="2e", display=display.none)
p2TA = input.float(3.0, "arm %", step=0.5, group=G2, inline="2e", display=display.none)
p2TM = input.float(2.0, "xATR", step=0.25, group=G2, inline="2e", display=display.none)
p2EX = input.int(0, "max hold", minval=0, maxval=250, group=G2, inline="2e", display=display.none)

G3 = "P3 playbook"
p3N = input.string("Failed breakout: reclaim the level", "P3 title", group=G3, display=display.none)
p3E = input.string("STLV", "Entry", options=["OPEN", "DELAY", "STH", "STPD", "STLV", "LMLV", "LMTC", "LMEMA", "SKIP"], group=G3, inline="3a", display=display.none)
p3O = input.float(0.1, "O xATR", step=0.05, group=G3, inline="3a", display=display.none)
p3V = input.int(10, "V", minval=1, maxval=60, group=G3, inline="3a", display=display.none)
p3L = input.float(0.3, "L xATR", minval=0.0, step=0.05, group=G3, inline="3b", display=display.none)
p3G = input.float(0.0, "G %", minval=0.0, step=0.25, group=G3, inline="3b", display=display.none)
p3F = input.string("NONE", "Fallback", options=["NONE", "OPEN"], group=G3, inline="3b", display=display.none)
p3S = input.string("NONE", "Stop", options=["NONE", "ATR", "PCT", "TLOW", "LVL"], group=G3, inline="3c", display=display.none)
p3SK = input.float(0.0, "SK", step=0.25, group=G3, inline="3c", display=display.none)
p3T = input.string("NONE", "Target", options=["NONE", "R", "PCT"], group=G3, inline="3c", display=display.none)
p3TK = input.float(0.0, "TK", step=0.25, group=G3, inline="3c", display=display.none)
p3H = input.int(5, "Hold H", minval=1, maxval=250, group=G3, inline="3d", display=display.none)
p3X = input.string("OPEN", "sell at", options=["OPEN", "CLOSE"], group=G3, inline="3d", display=display.none)
p3TR = input.bool(false, "Trail", group=G3, inline="3e", display=display.none)
p3TA = input.float(3.0, "arm %", step=0.5, group=G3, inline="3e", display=display.none)
p3TM = input.float(2.0, "xATR", step=0.25, group=G3, inline="3e", display=display.none)
p3EX = input.int(0, "max hold", minval=0, maxval=250, group=G3, inline="3e", display=display.none)

G4 = "P4 playbook"
p4N = input.string("Breakdown: bear-trap reclaim of the level", "P4 title", group=G4, display=display.none)
p4E = input.string("STLV", "Entry", options=["OPEN", "DELAY", "STH", "STPD", "STLV", "LMLV", "LMTC", "LMEMA", "SKIP"], group=G4, inline="4a", display=display.none)
p4O = input.float(0.25, "O xATR", step=0.05, group=G4, inline="4a", display=display.none)
p4V = input.int(5, "V", minval=1, maxval=60, group=G4, inline="4a", display=display.none)
p4L = input.float(0.3, "L xATR", minval=0.0, step=0.05, group=G4, inline="4b", display=display.none)
p4G = input.float(0.0, "G %", minval=0.0, step=0.25, group=G4, inline="4b", display=display.none)
p4F = input.string("NONE", "Fallback", options=["NONE", "OPEN"], group=G4, inline="4b", display=display.none)
p4S = input.string("NONE", "Stop", options=["NONE", "ATR", "PCT", "TLOW", "LVL"], group=G4, inline="4c", display=display.none)
p4SK = input.float(0.0, "SK", step=0.25, group=G4, inline="4c", display=display.none)
p4T = input.string("NONE", "Target", options=["NONE", "R", "PCT"], group=G4, inline="4c", display=display.none)
p4TK = input.float(0.0, "TK", step=0.25, group=G4, inline="4c", display=display.none)
p4H = input.int(5, "Hold H", minval=1, maxval=250, group=G4, inline="4d", display=display.none)
p4X = input.string("OPEN", "sell at", options=["OPEN", "CLOSE"], group=G4, inline="4d", display=display.none)
p4TR = input.bool(false, "Trail", group=G4, inline="4e", display=display.none)
p4TA = input.float(3.0, "arm %", step=0.5, group=G4, inline="4e", display=display.none)
p4TM = input.float(2.0, "xATR", step=0.25, group=G4, inline="4e", display=display.none)
p4EX = input.int(0, "max hold", minval=0, maxval=250, group=G4, inline="4e", display=display.none)

G5 = "P5 playbook"
p5N = input.string("Confirmation: above T's high", "P5 title", group=G5, display=display.none)
p5E = input.string("STH", "Entry", options=["OPEN", "DELAY", "STH", "STPD", "STLV", "LMLV", "LMTC", "LMEMA", "SKIP"], group=G5, inline="5a", display=display.none)
p5O = input.float(0.1, "O xATR", step=0.05, group=G5, inline="5a", display=display.none)
p5V = input.int(10, "V", minval=1, maxval=60, group=G5, inline="5a", display=display.none)
p5L = input.float(0.3, "L xATR", minval=0.0, step=0.05, group=G5, inline="5b", display=display.none)
p5G = input.float(0.0, "G %", minval=0.0, step=0.25, group=G5, inline="5b", display=display.none)
p5F = input.string("NONE", "Fallback", options=["NONE", "OPEN"], group=G5, inline="5b", display=display.none)
p5S = input.string("NONE", "Stop", options=["NONE", "ATR", "PCT", "TLOW", "LVL"], group=G5, inline="5c", display=display.none)
p5SK = input.float(0.0, "SK", step=0.25, group=G5, inline="5c", display=display.none)
p5T = input.string("NONE", "Target", options=["NONE", "R", "PCT"], group=G5, inline="5c", display=display.none)
p5TK = input.float(0.0, "TK", step=0.25, group=G5, inline="5c", display=display.none)
p5H = input.int(5, "Hold H", minval=1, maxval=250, group=G5, inline="5d", display=display.none)
p5X = input.string("OPEN", "sell at", options=["OPEN", "CLOSE"], group=G5, inline="5d", display=display.none)
p5TR = input.bool(false, "Trail", group=G5, inline="5e", display=display.none)
p5TA = input.float(3.0, "arm %", step=0.5, group=G5, inline="5e", display=display.none)
p5TM = input.float(2.0, "xATR", step=0.25, group=G5, inline="5e", display=display.none)
p5EX = input.int(0, "max hold", minval=0, maxval=250, group=G5, inline="5e", display=display.none)

G6 = "P6 playbook"
p6N = input.string("Pullback: limit at T's close - 1 ATR", "P6 title", group=G6, display=display.none)
p6E = input.string("LMTC", "Entry", options=["OPEN", "DELAY", "STH", "STPD", "STLV", "LMLV", "LMTC", "LMEMA", "SKIP"], group=G6, inline="6a", display=display.none)
p6O = input.float(1.0, "O xATR", step=0.05, group=G6, inline="6a", display=display.none)
p6V = input.int(3, "V", minval=1, maxval=60, group=G6, inline="6a", display=display.none)
p6L = input.float(0.3, "L xATR", minval=0.0, step=0.05, group=G6, inline="6b", display=display.none)
p6G = input.float(0.0, "G %", minval=0.0, step=0.25, group=G6, inline="6b", display=display.none)
p6F = input.string("NONE", "Fallback", options=["NONE", "OPEN"], group=G6, inline="6b", display=display.none)
p6S = input.string("NONE", "Stop", options=["NONE", "ATR", "PCT", "TLOW", "LVL"], group=G6, inline="6c", display=display.none)
p6SK = input.float(0.0, "SK", step=0.25, group=G6, inline="6c", display=display.none)
p6T = input.string("NONE", "Target", options=["NONE", "R", "PCT"], group=G6, inline="6c", display=display.none)
p6TK = input.float(0.0, "TK", step=0.25, group=G6, inline="6c", display=display.none)
p6H = input.int(5, "Hold H", minval=1, maxval=250, group=G6, inline="6d", display=display.none)
p6X = input.string("OPEN", "sell at", options=["OPEN", "CLOSE"], group=G6, inline="6d", display=display.none)
p6TR = input.bool(false, "Trail", group=G6, inline="6e", display=display.none)
p6TA = input.float(3.0, "arm %", step=0.5, group=G6, inline="6e", display=display.none)
p6TM = input.float(2.0, "xATR", step=0.25, group=G6, inline="6e", display=display.none)
p6EX = input.int(0, "max hold", minval=0, maxval=250, group=G6, inline="6e", display=display.none)

// the six playbooks as arrays (index 0 = P1)
var array<string> aN = array.from(p1N, p2N, p3N, p4N, p5N, p6N)
var array<string> aE = array.from(p1E, p2E, p3E, p4E, p5E, p6E)
var array<float> aO = array.from(p1O, p2O, p3O, p4O, p5O, p6O)
var array<int> aV = array.from(p1V, p2V, p3V, p4V, p5V, p6V)
var array<float> aL = array.from(p1L, p2L, p3L, p4L, p5L, p6L)
var array<float> aG = array.from(p1G, p2G, p3G, p4G, p5G, p6G)
var array<string> aF = array.from(p1F, p2F, p3F, p4F, p5F, p6F)
var array<string> aS = array.from(p1S, p2S, p3S, p4S, p5S, p6S)
var array<float> aSK = array.from(p1SK, p2SK, p3SK, p4SK, p5SK, p6SK)
var array<string> aT = array.from(p1T, p2T, p3T, p4T, p5T, p6T)
var array<float> aTK = array.from(p1TK, p2TK, p3TK, p4TK, p5TK, p6TK)
var array<int> aH = array.from(p1H, p2H, p3H, p4H, p5H, p6H)
var array<string> aX = array.from(p1X, p2X, p3X, p4X, p5X, p6X)
var array<bool> aTR = array.from(p1TR, p2TR, p3TR, p4TR, p5TR, p6TR)
var array<float> aTA = array.from(p1TA, p2TA, p3TA, p4TA, p5TA, p6TA)
var array<float> aTM = array.from(p1TM, p2TM, p3TM, p4TM, p5TM, p6TM)
var array<int> aEX = array.from(p1EX, p2EX, p3EX, p4EX, p5EX, p6EX)

// ============================================================================================================ types
// status codes
ST_WAIT = 0
ST_WORK = 1
ST_IN = 2
ST_DONE = 3
ST_SKIP = 4
ST_NO_ORDER = 5
ST_NO_LEVEL = 6
ST_NO_ATR = 7
ST_NO_FILL = 8
ST_NO_BAR = 9
ST_OUT = 10

type Pick
    int num = 0
    string id = ""
    string eng = ""
    int ymd = 0
    int rank = 0
    string st = ""
    string ev = ""
    int age = -1
    string rg = ""
    float lvr
    float tc
    float g6
    float g5
    string cat = ""
    int pb = 1
    int stat = 0
    string why = ""
    string mode = ""
    string how = "ORDER"
    string oid = ""
    string eid = ""
    int tbar = -1
    float tcc
    float th
    float tl
    float atrT
    float scale
    float lvl
    float trig
    float lim
    float wpx
    int ebar = -1
    float epx
    float stop
    float stop0
    float tgt
    float hic
    bool armed = false
    int txbar = -1
    int xbar = -1
    float xpx
    string reason = ""
    float net
    float tvnet
    float bE
    float b5
    float b6
    float bnet5
    float bnet6
    float bg6
    bool fin = false
    bool logged = false
    string verdict = ""
    string note = ""
    label lb

// ============================================================================================================ helpers
fnum(float x) =>
    str.tostring(x, "#.######")

pct(float x) =>
    string s = "-"
    if not na(x)
        s := (x >= 0 ? "+" : "") + str.tostring(x * 100, "0.00") + "%"
    s

netOf(float e, float x, float c) =>
    (x - e - c * (e + x)) / e

listOk(string lst, string allowed) =>
    bool ok = true
    if lst != "*" and lst != ""
        array<string> toks = str.split(lst, ",")
        for tok in toks
            if str.length(tok) > 0 and not str.contains(allowed, "," + tok + ",")
                ok := false
    ok

statName(int s) =>
    string r = "?"
    switch s
        ST_WAIT => r := "WAITING"
        ST_WORK => r := "WORKING"
        ST_IN => r := "IN_TRADE"
        ST_DONE => r := "FILLED"
        ST_SKIP => r := "SKIP"
        ST_NO_ORDER => r := "NO_ORDER"
        ST_NO_LEVEL => r := "NO_LEVEL"
        ST_NO_ATR => r := "NO_ATR"
        ST_NO_FILL => r := "NO_FILL"
        ST_NO_BAR => r := "NO_BAR"
        ST_OUT => r := "FILTERED"
    r

whyCode(string w) =>
    int r = ST_NO_FILL
    if w == "NO_ORDER"
        r := ST_NO_ORDER
    else if w == "NO_LEVEL"
        r := ST_NO_LEVEL
    else if w == "NO_ATR"
        r := ST_NO_ATR
    r

isFinal(int s) =>
    s == ST_DONE or s == ST_SKIP or s == ST_NO_ORDER or s == ST_NO_LEVEL or s == ST_NO_ATR or s == ST_NO_FILL

pbCode(int k) =>
    "P" + str.tostring(k + 1) + "=E:" + aE.get(k) + ",O:" + fnum(aO.get(k)) + ",V:" + str.tostring(aV.get(k)) + ",L:" + fnum(aL.get(k)) + ",G:" + fnum(aG.get(k)) + ",F:" + aF.get(k) + ",S:" + aS.get(k) + ",SK:" + fnum(aSK.get(k)) + ",T:" + aT.get(k) + ",TK:" + fnum(aTK.get(k)) + ",H:" + str.tostring(aH.get(k)) + ",X:" + aX.get(k) + ",TR:" + (aTR.get(k) ? "1" : "0") + ",TA:" + fnum(aTA.get(k)) + ",TM:" + fnum(aTM.get(k)) + ",EX:" + str.tostring(aEX.get(k))

pbDesc(int k) =>
    "P" + str.tostring(k + 1) + " " + aE.get(k) + " O " + fnum(aO.get(k)) + " V " + str.tostring(aV.get(k)) + " L " + fnum(aL.get(k)) + " G " + fnum(aG.get(k)) + " F " + aF.get(k) + " | stop " + aS.get(k) + " " + fnum(aSK.get(k)) + " target " + aT.get(k) + " " + fnum(aTK.get(k)) + " | hold " + str.tostring(aH.get(k)) + " sell at " + aX.get(k) + (aTR.get(k) ? " | trail arm " + fnum(aTA.get(k)) + "% " + fnum(aTM.get(k)) + " ATR max " + str.tostring(aEX.get(k)) : "")

// keep only what differs from the shipped defaults: 'BMPB1' alone = the defaults
shortCode(string full) =>
    array<string> a = str.split(full, "|")
    array<string> d = str.split(DEFAULT_CODE, "|")
    string out = TAG
    int na_ = a.size()
    if na_ > 1
        for j = 1 to na_ - 1
            string part = a.get(j)
            string dpart = ""
            if j < d.size()
                dpart := d.get(j)
            if part != dpart
                if str.startswith(part, "P") and str.startswith(dpart, "P")
                    array<string> kv = str.split(part, "=")
                    array<string> dkv = str.split(dpart, "=")
                    if kv.size() == 2 and dkv.size() == 2
                        array<string> f = str.split(kv.get(1), ",")
                        array<string> df = str.split(dkv.get(1), ",")
                        string keep = ""
                        int nf = f.size()
                        if nf > 0
                            for q = 0 to nf - 1
                                bool same = false
                                if q < df.size()
                                    same := f.get(q) == df.get(q)
                                if not same
                                    keep := keep + (keep == "" ? "" : ",") + f.get(q)
                        out := out + "|" + kv.get(0) + "=" + keep
                    else
                        out := out + "|" + part
                else
                    out := out + "|" + part
    out

wrap(string s, int w) =>
    string out = ""
    int n = str.length(s)
    int i = 0
    while i < n
        int e = math.min(n, i + w)
        out := out + (out == "" ? "" : "\n") + str.substring(s, i, e)
        i := e
    out

// ============================================================================================================ state
var array<Pick> picks = array.new<Pick>()
var map<string, int> byId = map.new<string, int>()
var array<int> ordIdx = array.new_int()
var array<int> kept = array.new_int()
var string hdrTag = ""
var string hdrSym = ""
var string hdrLine = ""
var int nBad = 0
var string badTxt = ""
var int nDup = 0
var int nOther = 0
var array<string> mSt = array.new_string()
var array<string> mEv = array.new_string()
var array<string> mRg = array.new_string()
var array<int> mPb = array.new_int()
var int nMapBad = 0
var string mapBadTxt = ""
var map<string, string> fVerdict = map.new<string, string>()
var map<string, string> fNote = map.new<string, string>()
var string CODE = ""
var string SHORT = ""
var int nxt = 0
var array<int> act = array.new_int()
var int seenClosed = 0
var int focusIdx = -1
var int nNoBar = 0
var int nOut = 0

matchPb(string s, string e, string r) =>
    int pb = 1
    bool hit = false
    int nr = mPb.size()
    if nr > 0
        for j = 0 to nr - 1
            if not hit
                string ms = mSt.get(j)
                string me = mEv.get(j)
                string mr = mRg.get(j)
                if (ms == "" or str.contains(ms, "," + s + ",")) and (me == "" or str.contains(me, "," + e + ",")) and (mr == "" or str.contains(mr, "," + r + ","))
                    pb := mPb.get(j)
                    hit := true
    pb

// ============================================================================================================ parse once
if barstate.isfirst
    // ---- the picks
    array<string> lines = str.split(str.replace_all(iPicks, "\r", ""), "\n")
    for raw in lines
        string ln = str.replace_all(raw, " ", "")
        if str.length(ln) > 0
            if str.startswith(ln, "#")
                hdrLine := ln
                array<string> h = str.split(str.substring(ln, 1), "|")
                if h.size() > 0
                    hdrTag := h.get(0)
                if h.size() > 1
                    hdrSym := h.get(1)
            else
                array<string> f = str.split(ln, ",")
                bool ok = f.size() >= 9
                bool dup = false
                bool other = false
                array<string> ip = array.new_string()
                if ok
                    ip := str.split(f.get(0), "-")
                    ok := ip.size() == 3
                if ok and f.size() >= 10
                    // a category file: keep this chart's lines only (inside the block: v5 'and' is not lazy)
                    if f.get(9) != (iTk != "" ? iTk : syminfo.ticker)
                        other := true
                        ok := false
                if ok
                    float ymdF = str.tonumber(ip.get(1))
                    float rkF = str.tonumber(ip.get(2))
                    ok := not na(ymdF) and not na(rkF) and (ip.get(0) == "D" or ip.get(0) == "ENS") and str.contains(STATES, "," + f.get(1) + ",") and str.contains(EVENTS, "," + f.get(2) + ",") and str.contains(REGIMES, "," + f.get(4) + ",")
                    if ok and byId.contains(f.get(0))
                        dup := true
                        ok := false
                    if ok
                        Pick p = Pick.new()
                        p.id := f.get(0)
                        p.eng := ip.get(0)
                        p.ymd := int(ymdF)
                        p.rank := int(rkF)
                        p.st := f.get(1)
                        p.ev := f.get(2)
                        float ag = str.tonumber(f.get(3))
                        p.age := na(ag) ? -1 : int(ag)
                        p.rg := f.get(4)
                        p.lvr := str.tonumber(f.get(5))
                        p.tc := str.tonumber(f.get(6))
                        p.g6 := str.tonumber(f.get(7))
                        p.g5 := str.tonumber(f.get(8))
                        p.cat := p.st + ":" + p.ev
                        byId.put(p.id, picks.size())
                        picks.push(p)
                if other
                    nOther += 1
                else if dup
                    nDup += 1
                else if not ok
                    nBad += 1
                    if badTxt == ""
                        badTxt := ln
    // date order (then engine D first, then rank)
    array<float> keys = array.new_float()
    for p in picks
        keys.push(p.ymd * 100.0 + (p.eng == "D" ? 0.0 : 50.0) + p.rank)
    ordIdx := array.sort_indices(keys, order.ascending)
    // ---- the mapping
    string mapClean = str.replace_all(str.replace_all(str.replace_all(iMap, "\r", ""), "\n", ";"), " ", "")
    array<string> rules = str.split(mapClean, ";")
    for r in rules
        if str.length(r) > 0
            bool okr = false
            array<string> lr = str.split(r, "=")
            if lr.size() == 2
                string pbS = lr.get(1)
                okr := pbS == "P1" or pbS == "P2" or pbS == "P3" or pbS == "P4" or pbS == "P5" or pbS == "P6"
                array<string> parts = str.split(lr.get(0), ":")
                okr := okr and parts.size() >= 1 and parts.size() <= 3
                if okr
                    string a0 = parts.get(0)
                    string a1 = "*"
                    string a2 = "*"
                    if parts.size() > 1
                        a1 := parts.get(1)
                    if parts.size() > 2
                        a2 := parts.get(2)
                    okr := listOk(a0, STATES) and listOk(a1, EVENTS) and listOk(a2, REGIMES)
                    if okr
                        mSt.push(a0 == "*" or a0 == "" ? "" : "," + a0 + ",")
                        mEv.push(a1 == "*" or a1 == "" ? "" : "," + a1 + ",")
                        mRg.push(a2 == "*" or a2 == "" ? "" : "," + a2 + ",")
                        mPb.push(int(str.tonumber(str.substring(pbS, 1))))
            if not okr
                nMapBad += 1
                if mapBadTxt == ""
                    mapBadTxt := r
    // ---- your findings
    array<string> flines = str.split(str.replace_all(iFind, "\r", ""), "\n")
    for fl in flines
        array<string> q = str.split(fl, "|")
        if q.size() >= 2
            string fid = str.replace_all(q.get(0), " ", "")
            fVerdict.put(fid, str.upper(str.replace_all(q.get(1), " ", "")))
            if q.size() >= 3
                fNote.put(fid, q.get(2))
    // ---- the config code (python playbook.py sim --code "<code>")
    CODE := TAG + "|C=" + fnum(iComm) + "|M=" + mapClean
    for k = 0 to 5
        CODE := CODE + "|" + pbCode(k)
    SHORT := shortCode(CODE)
    if iLog
        log.info("PBCFG|" + VERSION + "|" + CODE)
        log.info("PBHDR,num,trade_id,engine,rank,signal_day,category,regime,playbook,entry_rule,status,entry_how,order_id,entry_session,entry_px,exit_session,exit_px,exit_reason,net_pct,open6_net_pct,diff_pct,plan5_net_pct,tv_net_pct,price_scale,open6_gross_chart_pct,open6_gross_cache_pct,verdict,note")

// ============================================================================================================ every bar
float atr = ta.atr(14)
float ema20 = ta.ema(close, 20)
int ymdNow = year * 10000 + month * 100 + dayofmonth
bool isDaily = timeframe.isdaily and timeframe.multiplier == 1
string chartTk = iTk != "" ? iTk : syminfo.ticker
bool symOk = hdrSym == "" or hdrSym == "*" or hdrSym == chartTk
bool tradePb = iTrades != "OPEN6 baseline"
bool tradeB = iTrades != "Playbook"
float cc = iComm / 100.0
color fbg = na
array<int> finNow = array.new_int()

// ---- picks whose signal close is this bar
if isDaily and symOk
    int np = picks.size()
    while nxt < np
        int pi = ordIdx.get(nxt)
        Pick p = picks.get(pi)
        if p.ymd > ymdNow
            break
        if p.ymd < ymdNow
            p.stat := ST_NO_BAR
            nNoBar += 1
        else
            p.tbar := bar_index
            p.tcc := close
            p.th := high
            p.tl := low
            p.atrT := atr
            p.scale := p.tc > 0 ? close / p.tc : na
            p.lvl := na(p.lvr) ? na : p.lvr * close
            bool keep = (iEng == "ALL" or p.eng == iEng) and p.rank <= iMaxRank and p.ymd >= iFrom and p.ymd <= iTo and (iSt == "ALL" or p.st == iSt) and (iEv == "ALL" or p.ev == iEv) and (iRg == "ALL" or p.rg == iRg)
            if not keep
                p.stat := ST_OUT
                nOut += 1
            else
                kept.push(pi)
                p.num := kept.size()
                p.pb := iForce == "Mapping" ? matchPb(p.st, p.ev, p.rg) : int(str.tonumber(str.substring(iForce, 1)))
                if fVerdict.contains(p.id)
                    p.verdict := fVerdict.get(p.id)
                if fNote.contains(p.id)
                    p.note := fNote.get(p.id)
                if (iFocus > 0 and p.num == iFocus) or (iFocusId != "" and p.id == iFocusId)
                    focusIdx := pi
                act.push(pi)
                if iLabels
                    p.lb := label.new(bar_index, low, "#" + str.tostring(p.num) + " P" + str.tostring(p.pb), xloc=xloc.bar_index, yloc=yloc.belowbar, style=label.style_label_up, color=color.new(color.gray, 25), textcolor=color.white, size=size.tiny)
        nxt += 1

// ---- what the broker did during this bar: new fills
int nOpenT = strategy.opentrades
if nOpenT > 0
    for k = 0 to nOpenT - 1
        if strategy.opentrades.entry_bar_index(k) == bar_index
            string eid = strategy.opentrades.entry_id(k)
            if byId.contains(eid)
                Pick p = picks.get(byId.get(eid))
                if p.stat == ST_WORK
                    p.stat := ST_IN
                    p.eid := eid
                    p.ebar := bar_index
                    p.epx := strategy.opentrades.entry_price(k)

// ---- ... and closed trades (exit reason by the twin's rule)
int nClosedT = strategy.closedtrades
if nClosedT > seenClosed
    for k = seenClosed to nClosedT - 1
        string eid = strategy.closedtrades.entry_id(k)
        if byId.contains(eid)
            Pick p = picks.get(byId.get(eid))
            if p.stat == ST_IN
                p.xbar := strategy.closedtrades.exit_bar_index(k)
                p.xpx := strategy.closedtrades.exit_price(k)
                float val = strategy.closedtrades.entry_price(k) * math.abs(strategy.closedtrades.size(k))
                p.tvnet := val > 0 ? strategy.closedtrades.profit(k) / val : na
                string rs = "?"
                float tick = syminfo.mintick
                if p.txbar >= 0 and p.xbar == p.txbar
                    rs := "TIME"
                else if p.txbar >= 0 and p.xbar == p.txbar + 1
                    rs := "TIME"
                    if not na(p.stop) and open <= p.stop
                        rs := "STOP_GAP"
                    else if not na(p.tgt) and open >= p.tgt
                        rs := "TARGET_GAP"
                else
                    if not na(p.stop) and open <= p.stop
                        rs := "STOP_GAP"
                    else if not na(p.tgt) and open >= p.tgt
                        rs := "TARGET_GAP"
                    else if not na(p.stop) and p.xpx <= p.stop + tick
                        rs := "STOP"
                    else if not na(p.tgt) and p.xpx >= p.tgt - tick
                        rs := "TARGET"
                if p.armed and str.startswith(rs, "STOP")
                    rs := "TRAIL" + str.substring(rs, 4)
                p.reason := rs
                p.net := netOf(p.epx, p.xpx, cc)
                p.stat := ST_DONE
    seenClosed := nClosedT

// ---- the script at this close, pick by pick (the twin's steps, in its order)
int nAct = act.size()
if nAct > 0
    for j = nAct - 1 to 0
        int pi = act.get(j)
        Pick p = picks.get(pi)
        int k = bar_index - p.tbar
        int q = p.pb - 1
        string pE = aE.get(q)
        int pV = aV.get(q)
        bool isFocus = pi == focusIdx
        string cmt = "#" + str.tostring(p.num) + " P" + str.tostring(p.pb) + " " + pE
        // the open entry from the chart's bars (always)
        if k == 1
            p.bE := open
        if k == 5 and not na(p.bE)
            p.b5 := close
            p.bnet5 := netOf(p.bE, close, cc)
        if k == 6 and not na(p.bE)
            p.b6 := open
            p.bnet6 := netOf(p.bE, open, cc)
            p.bg6 := open / p.bE - 1
        if tradeB
            if k == 0
                strategy.entry("B~" + p.id, strategy.long, comment="B #" + str.tostring(p.num))
            if k == 5
                strategy.close("B~" + p.id, comment="B out")
        // the playbook
        if tradePb
            string fbWhy = ""
            if k == 0
                float aT0 = p.atrT
                if pE == "SKIP"
                    p.stat := ST_SKIP
                else if pE == "OPEN"
                    p.stat := ST_WORK
                    p.oid := p.id
                    if aG.get(q) > 0
                        p.lim := close * (1 + aG.get(q) / 100)
                        strategy.entry(p.oid, strategy.long, limit=p.lim, comment=cmt)
                    else
                        strategy.entry(p.oid, strategy.long, comment=cmt)
                        p.mode := "MKT"
                else if pE == "DELAY"
                    p.stat := ST_WORK
                else if (pE == "STLV" or pE == "LMLV") and na(p.lvl)
                    fbWhy := "NO_LEVEL"
                else if na(aT0)
                    fbWhy := "NO_ATR"
                else
                    p.stat := ST_WORK
                    if pE == "STH" or pE == "STLV"
                        p.trig := (pE == "STH" ? high : p.lvl) + aO.get(q) * aT0
                        if p.trig > close
                            p.oid := p.id
                            if aL.get(q) > 0
                                strategy.entry(p.oid, strategy.long, stop=p.trig, limit=p.trig + aL.get(q) * aT0, comment=cmt)
                            else
                                strategy.entry(p.oid, strategy.long, stop=p.trig, comment=cmt)
                        else
                            fbWhy := "NO_ORDER"
                    else if pE == "STPD"
                        float tr0 = high + aO.get(q) * aT0
                        if tr0 > close
                            p.wpx := tr0
                            p.oid := p.id + "~0"
                            byId.put(p.oid, pi)
                            if aL.get(q) > 0
                                strategy.entry(p.oid, strategy.long, stop=tr0, limit=tr0 + aL.get(q) * aT0, comment=cmt)
                            else
                                strategy.entry(p.oid, strategy.long, stop=tr0, comment=cmt)
                    else if pE == "LMLV" or pE == "LMTC"
                        p.lim := pE == "LMLV" ? p.lvl + aO.get(q) * aT0 : close - aO.get(q) * aT0
                        p.oid := p.id
                        strategy.entry(p.oid, strategy.long, limit=p.lim, comment=cmt)
                    else if pE == "LMEMA"
                        p.wpx := ema20 + aO.get(q) * aT0
                        p.oid := p.id + "~0"
                        byId.put(p.oid, pi)
                        strategy.entry(p.oid, strategy.long, limit=p.wpx, comment=cmt)
            else if p.stat == ST_WORK and p.mode != "MKT"
                if pE == "OPEN"
                    strategy.cancel(p.oid)
                    fbWhy := "NO_FILL"
                else if pE == "DELAY"
                    if k == pV
                        p.oid := p.id
                        strategy.entry(p.oid, strategy.long, comment=cmt)
                        p.mode := "MKT"
                else if k >= pV
                    if p.oid != ""
                        strategy.cancel(p.oid)
                    fbWhy := "NO_FILL"
                else if pE == "STH" or pE == "STLV"
                    if not (p.trig > close)
                        strategy.cancel(p.oid)
                        fbWhy := "NO_FILL"
                else if pE == "STPD" or pE == "LMEMA"
                    // a fresh order (its own id) every evening: never a modified, possibly triggered, old one
                    if p.oid != ""
                        strategy.cancel(p.oid)
                    p.oid := ""
                    p.wpx := na
                    if not na(atr)
                        float wN = pE == "STPD" ? high + aO.get(q) * atr : ema20 + aO.get(q) * atr
                        if pE == "LMEMA" or wN > close
                            p.wpx := wN
                            p.oid := p.id + "~" + str.tostring(k)
                            byId.put(p.oid, pi)
                            if pE == "LMEMA"
                                strategy.entry(p.oid, strategy.long, limit=wN, comment=cmt)
                            else if aL.get(q) > 0
                                strategy.entry(p.oid, strategy.long, stop=wN, limit=wN + aL.get(q) * atr, comment=cmt)
                            else
                                strategy.entry(p.oid, strategy.long, stop=wN, comment=cmt)
            // the fallback (F = OPEN: market at the next open) or the final no-trade status
            if fbWhy != ""
                p.why := fbWhy
                if aF.get(q) == "OPEN"
                    p.oid := p.id + "~F"
                    byId.put(p.oid, pi)
                    strategy.entry(p.oid, strategy.long, comment=cmt + " fallback")
                    p.mode := "MKT"
                    p.how := "FALLBACK"
                    p.stat := ST_WORK
                else
                    p.stat := whyCode(fbWhy)
            // in the trade (the entry session included): protective orders, trail, time exit
            if p.stat == ST_IN
                bool first = bar_index == p.ebar
                if first
                    string pS = aS.get(q)
                    float sk = aSK.get(q)
                    if pS == "ATR" and not na(atr)
                        p.stop := p.epx - sk * atr
                    else if pS == "PCT"
                        p.stop := p.epx * (1 - sk / 100)
                    else if pS == "TLOW" and not na(p.atrT)
                        p.stop := p.tl - sk * p.atrT
                    else if pS == "LVL" and not na(p.lvl) and not na(p.atrT)
                        p.stop := p.lvl - sk * p.atrT
                    string pT = aT.get(q)
                    if pT == "R" and not na(p.stop) and p.epx > p.stop
                        p.tgt := p.epx + aTK.get(q) * (p.epx - p.stop)
                    else if pT == "PCT"
                        p.tgt := p.epx * (1 + aTK.get(q) / 100)
                    p.hic := p.epx
                    p.stop0 := p.stop
                p.hic := math.max(p.hic, close)
                if aTR.get(q)
                    if not p.armed and close > p.epx * (1 + aTA.get(q) / 100)
                        p.armed := true
                    if p.armed and not na(atr)
                        float lv = math.max(p.epx * (1 + 2 * cc), p.hic - aTM.get(q) * atr)
                        p.stop := na(p.stop) ? lv : math.max(p.stop, lv)
                if not na(p.stop) or not na(p.tgt)
                    strategy.exit("X~" + p.id, from_entry=p.eid, stop=p.stop, limit=p.tgt, comment="#" + str.tostring(p.num) + " exit")
                    if isFocus and not na(p.stop)
                        line.new(bar_index, p.stop, bar_index + 1, p.stop, xloc=xloc.bar_index, color=p.armed ? color.orange : color.red, style=line.style_solid, width=2)
                int held = bar_index - p.ebar + 1
                int limH = p.armed and aEX.get(q) > aH.get(q) ? aEX.get(q) : aH.get(q)
                if held >= limH and p.txbar < 0
                    p.txbar := bar_index
                    if aX.get(q) == "CLOSE"
                        strategy.close(p.eid, comment="#" + str.tostring(p.num) + " time", immediately=true)
                    else
                        strategy.close(p.eid, comment="#" + str.tostring(p.num) + " time")
        // the focus pick's sessions
        if isFocus
            if k == 0
                fbg := color.new(color.blue, 80)
            else if p.stat == ST_WORK or p.ebar == bar_index
                fbg := color.new(color.yellow, 85)
            else if p.stat == ST_IN or p.xbar == bar_index
                fbg := color.new(color.green, 85)
        // finished: the playbook has its result and the open entry has its T+6 open
        bool pbDone = not tradePb or isFinal(p.stat)
        if pbDone and k >= 6
            p.fin := true
            finNow.push(pi)
            act.remove(j)

// ============================================================================================================ output
px(float x) =>
    na(x) ? "-" : str.tostring(x, format.mintick)

num4(float x) =>
    na(x) ? "" : str.tostring(x, "0.0000")

pbNet(Pick p) =>
    // the playbook's result per pick: a trade's net, 0 for a final no-trade status, na while it is still open
    float r = na
    if p.stat == ST_DONE
        r := p.net
    else if isFinal(p.stat)
        r := 0.0
    r

stName(Pick p) =>
    p.stat == ST_DONE ? "FILLED" : (p.fin ? statName(p.stat) : "OPEN_AT_END")

pickTip(Pick p) =>
    int q = p.pb - 1
    string s = "#" + str.tostring(p.num) + "  " + p.id + "  (engine " + p.eng + ", rank " + str.tostring(p.rank) + ", T " + str.tostring(p.ymd) + ")"
    s := s + "\n" + p.cat + "  age " + str.tostring(p.age) + "  regime " + p.rg
    s := s + "\n" + pbDesc(q) + "\n" + aN.get(q)
    if not na(p.lvl)
        s := s + "\nlevel " + px(p.lvl) + " (" + str.tostring(p.lvr, "0.000") + " x T close)"
    if not na(p.trig)
        s := s + "  trigger " + px(p.trig)
    if not na(p.lim)
        s := s + "  limit " + px(p.lim)
    s := s + "\nplaybook: " + stName(p) + (p.why != "" ? " (" + p.why + ")" : "")
    if p.ebar >= 0
        s := s + "\n  in T+" + str.tostring(p.ebar - p.tbar) + " @ " + px(p.epx) + " (" + p.how + ", order " + p.eid + ")"
        if not na(p.stop0)
            s := s + "  stop " + px(p.stop0)
        if not na(p.tgt)
            s := s + "  target " + px(p.tgt)
    if p.xbar >= 0
        s := s + "\n  out T+" + str.tostring(p.xbar - p.tbar) + " @ " + px(p.xpx) + " " + p.reason + (p.armed ? " (trail armed, last stop " + px(p.stop) + ")" : "") + "  net " + pct(p.net)
    s := s + "\nOPEN6: in T+1 @ " + px(p.bE) + "  out T+6 @ " + px(p.b6) + "  net " + pct(p.bnet6) + "   PLAN5 " + pct(p.bnet5)
    s := s + "\ndifference (playbook - OPEN6) " + pct(pbNet(p) - p.bnet6)
    s := s + "\ndata: chart / cache price " + (na(p.scale) ? "-" : str.tostring(p.scale, "0.0000")) + "; OPEN6 gross chart " + pct(p.bg6) + " vs cache " + pct(p.g6)
    if p.verdict != "" or p.note != ""
        s := s + "\nyour verdict: " + p.verdict + "  " + p.note
    s

pickLog(Pick p) =>
    int q = p.pb - 1
    string a = "PBLOG," + str.tostring(p.num) + "," + p.id + "," + p.eng + "," + str.tostring(p.rank) + "," + str.tostring(p.ymd) + "," + p.cat + "," + p.rg + ",P" + str.tostring(p.pb) + "," + aE.get(q) + "," + stName(p)
    string b = "," + (p.ebar >= 0 ? p.how : "") + "," + p.eid + "," + (p.ebar >= 0 ? str.tostring(p.ebar - p.tbar) : "") + "," + (p.ebar >= 0 ? str.tostring(p.epx) : "") + "," + (p.xbar >= 0 ? str.tostring(p.xbar - p.tbar) : "") + "," + (p.xbar >= 0 ? str.tostring(p.xpx) : "") + "," + p.reason
    string c = "," + num4(p.net * 100) + "," + num4(p.bnet6 * 100) + "," + num4((pbNet(p) - p.bnet6) * 100) + "," + num4(p.bnet5 * 100) + "," + num4(p.tvnet * 100) + "," + num4(p.scale) + "," + num4(p.bg6 * 100) + "," + num4(p.g6 * 100) + "," + p.verdict + "," + str.replace_all(p.note, ",", ";")
    a + b + c

pickColor(Pick p) =>
    float d = pbNet(p) - p.bnet6
    color c = color.new(color.gray, 25)
    if not p.fin
        c := color.new(color.orange, 20)
    else if not na(d) and d > 0.0005
        c := color.new(color.green, 15)
    else if not na(d) and d < -0.0005
        c := color.new(color.red, 15)
    c

// on the last bar every pick still in progress is shown as it stands (OPEN_AT_END)
if barstate.islast
    int nA = act.size()
    if nA > 0
        for j = 0 to nA - 1
            finNow.push(act.get(j))

int nFin = finNow.size()
if nFin > 0
    for j = 0 to nFin - 1
        int pi = finNow.get(j)
        Pick p = picks.get(pi)
        if not p.logged
            p.logged := true
            // a close sent 'immediately' on the last bar is not in closedtrades yet
            if p.stat == ST_IN and p.txbar == bar_index and aX.get(p.pb - 1) == "CLOSE"
                p.xbar := bar_index
                p.xpx := close
                p.reason := "TIME"
                p.net := netOf(p.epx, p.xpx, cc)
                p.stat := ST_DONE
            if not na(p.lb)
                float dd = pbNet(p) - p.bnet6
                label.set_text(p.lb, "#" + str.tostring(p.num) + " P" + str.tostring(p.pb) + (na(dd) ? "" : " " + (dd >= 0 ? "+" : "") + str.tostring(dd * 100, "0.0")))
                label.set_color(p.lb, pickColor(p))
                label.set_tooltip(p.lb, pickTip(p))
            if iLog
                log.info(pickLog(p))
            if pi == focusIdx
                int t0 = p.tbar
                float ordPx = not na(p.trig) ? p.trig : p.lim
                if not na(ordPx)
                    line.new(t0, ordPx, t0 + aV.get(p.pb - 1), ordPx, xloc=xloc.bar_index, color=color.orange, style=line.style_dotted, width=2)
                if not na(p.lvl)
                    line.new(math.max(0, t0 - 5), p.lvl, t0 + 1, p.lvl, xloc=xloc.bar_index, color=color.purple, style=line.style_dashed, width=1)
                if p.ebar >= 0
                    int x2 = p.xbar >= 0 ? p.xbar : bar_index
                    line.new(p.ebar, p.epx, x2, p.epx, xloc=xloc.bar_index, color=color.blue, style=line.style_solid, width=2)
                    label.new(p.ebar, p.epx, "IN " + px(p.epx), xloc=xloc.bar_index, style=label.style_label_right, color=color.blue, textcolor=color.white, size=size.small)
                    if not na(p.tgt)
                        line.new(p.ebar, p.tgt, x2, p.tgt, xloc=xloc.bar_index, color=color.green, style=line.style_dashed, width=1)
                if p.xbar >= 0
                    label.new(p.xbar, p.xpx, "OUT " + p.reason + " " + px(p.xpx) + " " + pct(p.net), xloc=xloc.bar_index, style=label.style_label_left, color=color.navy, textcolor=color.white, size=size.small)
                if not na(p.bE)
                    int bx = not na(p.b6) ? t0 + 6 : bar_index
                    float byy = not na(p.b6) ? p.b6 : close
                    line.new(t0 + 1, p.bE, bx, byy, xloc=xloc.bar_index, color=color.gray, style=line.style_dashed, width=2)
                    label.new(bx, byy, "OPEN6 " + pct(p.bnet6), xloc=xloc.bar_index, style=label.style_label_left, color=color.gray, textcolor=color.white, size=size.small)
bgcolor(fbg)

// ============================================================================================================ tables
txs = iTxt == "tiny" ? size.tiny : iTxt == "normal" ? size.normal : size.small
C_HEAD = color.new(color.blue, 35)
C_CELL = color.new(color.black, 25)
C_TXT = color.white
C_BAD = color.new(color.red, 20)
C_GOOD = color.new(color.green, 30)
var table tAud = table.new(position.top_left, 2, 12, border_width=1, border_color=color.new(color.gray, 60))
var table tSum = table.new(position.top_right, 9, 44, border_width=1, border_color=color.new(color.gray, 60))
var table tList = table.new(position.bottom_left, 12, 42, border_width=1, border_color=color.new(color.gray, 60))
var table tFoc = table.new(position.bottom_right, 2, 18, border_width=1, border_color=color.new(color.gray, 60))

if barstate.islast
    // ---------------------------------------------------------------- audit
    float maxTv = 0.0
    int nTv = 0
    float maxG = 0.0
    int nGbad = 0
    float sMin = na
    float sMax = na
    int nOpenEnd = 0
    for p in picks
        if p.num > 0
            if p.stat == ST_DONE and not na(p.tvnet)
                maxTv := math.max(maxTv, math.abs(p.tvnet - p.net))
                nTv += 1
            if not na(p.bg6) and not na(p.g6)
                maxG := math.max(maxG, math.abs(p.bg6 - p.g6))
                if math.abs(p.bg6 - p.g6) > 0.002
                    nGbad += 1
            if not na(p.scale)
                sMin := na(sMin) ? p.scale : math.min(sMin, p.scale)
                sMax := na(sMax) ? p.scale : math.max(sMax, p.scale)
            if not p.fin
                nOpenEnd += 1
    if iShowAud
        table.clear(tAud, 0, 0, 1, 11)
        table.cell(tAud, 0, 0, "BigMove Playbook", text_color=C_TXT, bgcolor=C_HEAD, text_size=txs)
        table.cell(tAud, 1, 0, VERSION + "  (" + TAG + ")", text_color=C_TXT, bgcolor=C_HEAD, text_size=txs, text_halign=text.align_left)
        table.cell(tAud, 0, 1, "Symbol", text_color=C_TXT, bgcolor=C_CELL, text_size=txs)
        string symTxt = hdrSym == "" ? "no header line in Picks (cannot check the symbol)" : hdrSym == "*" ? "category file: " + str.tostring(picks.size()) + " picks on this chart (" + chartTk + "), " + str.tostring(nOther) + " on other symbols skipped  OK" : "picks for " + hdrSym + ", chart " + syminfo.ticker + (iTk != "" ? " (matched as " + iTk + ")" : "") + (symOk ? "  OK" : "  MISMATCH: nothing is traded (or set 'Ticker in the file')")
        table.cell(tAud, 1, 1, symTxt + (hdrTag != "" and hdrTag != TAG ? "  (header tag " + hdrTag + " is not " + TAG + ")" : ""), text_color=C_TXT, bgcolor=symOk and hdrSym != "" and (hdrTag == "" or hdrTag == TAG) ? C_CELL : C_BAD, text_size=txs, text_halign=text.align_left)
        table.cell(tAud, 0, 2, "Timeframe", text_color=C_TXT, bgcolor=C_CELL, text_size=txs)
        table.cell(tAud, 1, 2, isDaily ? "1D  OK" : "NOT 1D: nothing is traded (use the daily chart)", text_color=C_TXT, bgcolor=isDaily ? C_CELL : C_BAD, text_size=txs, text_halign=text.align_left)
        table.cell(tAud, 0, 3, "Picks", text_color=C_TXT, bgcolor=C_CELL, text_size=txs)
        table.cell(tAud, 1, 3, str.tostring(picks.size()) + " read, " + str.tostring(kept.size()) + " shown, " + str.tostring(nOut) + " filtered out, " + str.tostring(nNoBar) + " not on this chart, " + str.tostring(nOpenEnd) + " still open at the last bar" + (nBad > 0 ? ", " + str.tostring(nBad) + " BAD lines (first: " + badTxt + ")" : "") + (nDup > 0 ? ", " + str.tostring(nDup) + " duplicates ignored" : ""), text_color=C_TXT, bgcolor=nBad > 0 or picks.size() == 0 ? C_BAD : C_CELL, text_size=txs, text_halign=text.align_left)
        table.cell(tAud, 0, 4, "Mapping", text_color=C_TXT, bgcolor=C_CELL, text_size=txs)
        table.cell(tAud, 1, 4, str.tostring(mPb.size()) + " rules" + (nMapBad > 0 ? ", " + str.tostring(nMapBad) + " BAD rules ignored (first: " + mapBadTxt + ")" : "") + (iForce != "Mapping" ? "; OVERRIDDEN: " + iForce + " on every pick" : ""), text_color=C_TXT, bgcolor=nMapBad > 0 ? C_BAD : C_CELL, text_size=txs, text_halign=text.align_left)
        table.cell(tAud, 0, 5, "Trades", text_color=C_TXT, bgcolor=C_CELL, text_size=txs)
        table.cell(tAud, 1, 5, "Strategy Tester trades: " + iTrades + "; commission " + fnum(iComm) + "% a side", text_color=C_TXT, bgcolor=C_CELL, text_size=txs, text_halign=text.align_left)
        table.cell(tAud, 0, 6, "TV check", text_color=C_TXT, bgcolor=C_CELL, text_size=txs)
        table.cell(tAud, 1, 6, nTv == 0 ? "no closed playbook trades" : "TradingView's own net vs this table's net: max difference " + str.tostring(maxTv * 100, "0.0000") + "% over " + str.tostring(nTv) + " trades" + (maxTv > 0.0001 ? "  (Properties > Commission is not " + fnum(iComm) + "%?)" : "  OK"), text_color=C_TXT, bgcolor=maxTv > 0.0001 ? C_BAD : C_CELL, text_size=txs, text_halign=text.align_left)
        table.cell(tAud, 0, 7, "Data check", text_color=C_TXT, bgcolor=C_CELL, text_size=txs)
        table.cell(tAud, 1, 7, "OPEN6 gross, chart vs cache: max difference " + str.tostring(maxG * 100, "0.00") + "%, " + str.tostring(nGbad) + " picks off by more than 0.2%; chart / cache price " + (na(sMin) ? "-" : str.tostring(sMin, "0.000") + " .. " + str.tostring(sMax, "0.000")), text_color=C_TXT, bgcolor=nGbad > 0 ? C_BAD : C_CELL, text_size=txs, text_halign=text.align_left)
        table.cell(tAud, 0, 8, "Config (short)", text_color=C_TXT, bgcolor=C_CELL, text_size=txs)
        table.cell(tAud, 1, 8, wrap(SHORT, 110), text_color=color.yellow, bgcolor=C_CELL, text_size=txs, text_halign=text.align_left)
        table.cell(tAud, 0, 9, "Run it on every pick", text_color=C_TXT, bgcolor=C_CELL, text_size=txs)
        table.cell(tAud, 1, 9, "python playbook.py sim --root %CACHE_DAILY_ROOT% --out %PB_OUT% --code \"" + SHORT + "\"" + (iForce != "Mapping" ? " --force " + iForce : ""), text_color=C_TXT, bgcolor=C_CELL, text_size=txs, text_halign=text.align_left)
        table.cell(tAud, 0, 10, "Full code", text_color=C_TXT, bgcolor=C_CELL, text_size=txs)
        table.cell(tAud, 1, 10, "first line of Pine Logs (PBCFG). Per pick: PBLOG lines; 'scroll to bar' jumps to the pick's last session", text_color=C_TXT, bgcolor=C_CELL, text_size=txs, text_halign=text.align_left)
    // ---------------------------------------------------------------- per category
    if iShowSum
        table.clear(tSum, 0, 0, 8, 43)
        map<string, int> rowOf = map.new<string, int>()
        array<string> cats = array.new_string()
        array<int> cN = array.new_int()
        array<int> cOpen = array.new_int()
        array<int> cF = array.new_int()
        array<float> cP = array.new_float()
        array<float> cB = array.new_float()
        array<int> cBet = array.new_int()
        array<int> cWor = array.new_int()
        array<string> cPbs = array.new_string()
        array<int> vB = array.new_int()
        array<int> vW = array.new_int()
        array<int> vS = array.new_int()
        for p in picks
            if p.num > 0
                string key = p.cat
                if not rowOf.contains(key)
                    rowOf.put(key, cats.size())
                    cats.push(key)
                    cN.push(0)
                    cOpen.push(0)
                    cF.push(0)
                    cP.push(0.0)
                    cB.push(0.0)
                    cBet.push(0)
                    cWor.push(0)
                    cPbs.push("")
                    vB.push(0)
                    vW.push(0)
                    vS.push(0)
                int r = rowOf.get(key)
                string pbT = "P" + str.tostring(p.pb)
                if not str.contains(cPbs.get(r), pbT)
                    cPbs.set(r, cPbs.get(r) + (cPbs.get(r) == "" ? "" : " ") + pbT)
                if p.verdict == "BETTER"
                    vB.set(r, vB.get(r) + 1)
                else if p.verdict == "WORSE"
                    vW.set(r, vW.get(r) + 1)
                else if p.verdict == "SAME"
                    vS.set(r, vS.get(r) + 1)
                float pn = tradePb ? pbNet(p) : 0.0
                if na(pn) or na(p.bnet6)
                    cOpen.set(r, cOpen.get(r) + 1)
                else
                    cN.set(r, cN.get(r) + 1)
                    if p.stat == ST_DONE
                        cF.set(r, cF.get(r) + 1)
                    cP.set(r, cP.get(r) + pn)
                    cB.set(r, cB.get(r) + p.bnet6)
                    if pn - p.bnet6 > 0.0005
                        cBet.set(r, cBet.get(r) + 1)
                    else if pn - p.bnet6 < -0.0005
                        cWor.set(r, cWor.get(r) + 1)
        table.cell(tSum, 0, 0, "Category", text_color=C_TXT, bgcolor=C_HEAD, text_size=txs)
        table.cell(tSum, 1, 0, "Playbook", text_color=C_TXT, bgcolor=C_HEAD, text_size=txs)
        table.cell(tSum, 2, 0, "Picks", text_color=C_TXT, bgcolor=C_HEAD, text_size=txs, tooltip="settled picks (+ still open at the last bar)")
        table.cell(tSum, 3, 0, "Filled", text_color=C_TXT, bgcolor=C_HEAD, text_size=txs)
        table.cell(tSum, 4, 0, "Playbook net/pick", text_color=C_TXT, bgcolor=C_HEAD, text_size=txs, tooltip="mean over settled picks; a pick that never filled counts 0")
        table.cell(tSum, 5, 0, "OPEN6 net/pick", text_color=C_TXT, bgcolor=C_HEAD, text_size=txs, tooltip="buy T+1's open, sell T+6's open, same commission")
        table.cell(tSum, 6, 0, "Difference", text_color=C_TXT, bgcolor=C_HEAD, text_size=txs)
        table.cell(tSum, 7, 0, "Better / worse", text_color=C_TXT, bgcolor=C_HEAD, text_size=txs, tooltip="picks where the playbook beat / lost to OPEN6 by more than 0.05%")
        table.cell(tSum, 8, 0, "Your verdicts B/W/S", text_color=C_TXT, bgcolor=C_HEAD, text_size=txs)
        int nCat = cats.size()
        int totN = 0
        int totO = 0
        int totF = 0
        float totP = 0.0
        float totB = 0.0
        int totBet = 0
        int totWor = 0
        if nCat > 0
            array<int> srt = array.sort_indices(cN, order.descending)
            for r = 0 to math.min(nCat, 41) - 1
                int c = srt.get(r)
                int n = cN.get(c)
                float mp = n > 0 ? cP.get(c) / n : na
                float mb = n > 0 ? cB.get(c) / n : na
                table.cell(tSum, 0, r + 1, cats.get(c), text_color=C_TXT, bgcolor=C_CELL, text_size=txs, text_halign=text.align_left)
                table.cell(tSum, 1, r + 1, tradePb ? cPbs.get(c) : "-", text_color=C_TXT, bgcolor=C_CELL, text_size=txs)
                table.cell(tSum, 2, r + 1, str.tostring(n) + (cOpen.get(c) > 0 ? " (+" + str.tostring(cOpen.get(c)) + ")" : ""), text_color=C_TXT, bgcolor=C_CELL, text_size=txs)
                table.cell(tSum, 3, r + 1, tradePb ? str.tostring(cF.get(c)) : "-", text_color=C_TXT, bgcolor=C_CELL, text_size=txs)
                table.cell(tSum, 4, r + 1, tradePb ? pct(mp) : "-", text_color=C_TXT, bgcolor=C_CELL, text_size=txs)
                table.cell(tSum, 5, r + 1, pct(mb), text_color=C_TXT, bgcolor=C_CELL, text_size=txs)
                table.cell(tSum, 6, r + 1, tradePb ? pct(mp - mb) : "-", text_color=C_TXT, bgcolor=not tradePb or na(mp - mb) ? C_CELL : (mp - mb > 0 ? C_GOOD : C_BAD), text_size=txs)
                table.cell(tSum, 7, r + 1, tradePb ? str.tostring(cBet.get(c)) + " / " + str.tostring(cWor.get(c)) : "-", text_color=C_TXT, bgcolor=C_CELL, text_size=txs)
                table.cell(tSum, 8, r + 1, str.tostring(vB.get(c)) + " / " + str.tostring(vW.get(c)) + " / " + str.tostring(vS.get(c)), text_color=C_TXT, bgcolor=C_CELL, text_size=txs)
            for c = 0 to nCat - 1
                totN += cN.get(c)
                totO += cOpen.get(c)
                totF += cF.get(c)
                totP += cP.get(c)
                totB += cB.get(c)
                totBet += cBet.get(c)
                totWor += cWor.get(c)
        int rr = math.min(nCat, 41) + 1
        float tp = totN > 0 ? totP / totN : na
        float tb = totN > 0 ? totB / totN : na
        table.cell(tSum, 0, rr, "ALL", text_color=C_TXT, bgcolor=C_HEAD, text_size=txs, text_halign=text.align_left)
        table.cell(tSum, 1, rr, "", text_color=C_TXT, bgcolor=C_HEAD, text_size=txs)
        table.cell(tSum, 2, rr, str.tostring(totN) + (totO > 0 ? " (+" + str.tostring(totO) + ")" : ""), text_color=C_TXT, bgcolor=C_HEAD, text_size=txs)
        table.cell(tSum, 3, rr, tradePb ? str.tostring(totF) : "-", text_color=C_TXT, bgcolor=C_HEAD, text_size=txs)
        table.cell(tSum, 4, rr, tradePb ? pct(tp) : "-", text_color=C_TXT, bgcolor=C_HEAD, text_size=txs)
        table.cell(tSum, 5, rr, pct(tb), text_color=C_TXT, bgcolor=C_HEAD, text_size=txs)
        table.cell(tSum, 6, rr, tradePb ? pct(tp - tb) : "-", text_color=C_TXT, bgcolor=C_HEAD, text_size=txs)
        table.cell(tSum, 7, rr, tradePb ? str.tostring(totBet) + " / " + str.tostring(totWor) : "-", text_color=C_TXT, bgcolor=C_HEAD, text_size=txs)
        table.cell(tSum, 8, rr, "", text_color=C_TXT, bgcolor=C_HEAD, text_size=txs)
    // ---------------------------------------------------------------- the pick list (one page)
    if iPage > 0
        table.clear(tList, 0, 0, 11, 41)
        array<string> hd = array.from("#", "Trade id", "Category", "Rg", "PB", "Status", "In", "Out", "Net", "OPEN6", "Diff", "Verdict")
        for c = 0 to 11
            table.cell(tList, c, 0, hd.get(c), text_color=C_TXT, bgcolor=C_HEAD, text_size=txs)
        int first = (iPage - 1) * iRows
        int nk = kept.size()
        int shown = 0
        if first < nk
            for r = first to math.min(nk, first + iRows) - 1
                Pick p = picks.get(kept.get(r))
                int row = r - first + 1
                float pn = pbNet(p)
                bool foc = kept.get(r) == focusIdx
                color bgc = foc ? color.new(color.purple, 40) : C_CELL
                table.cell(tList, 0, row, str.tostring(p.num), text_color=C_TXT, bgcolor=bgc, text_size=txs)
                table.cell(tList, 1, row, p.id, text_color=C_TXT, bgcolor=bgc, text_size=txs, text_halign=text.align_left, tooltip=pickTip(p))
                table.cell(tList, 2, row, p.cat, text_color=C_TXT, bgcolor=bgc, text_size=txs, text_halign=text.align_left)
                table.cell(tList, 3, row, p.rg, text_color=C_TXT, bgcolor=bgc, text_size=txs)
                table.cell(tList, 4, row, tradePb ? "P" + str.tostring(p.pb) + " " + aE.get(p.pb - 1) : "-", text_color=C_TXT, bgcolor=bgc, text_size=txs)
                table.cell(tList, 5, row, tradePb ? stName(p) + (p.how == "FALLBACK" and p.ebar >= 0 ? " (fb)" : "") : "-", text_color=C_TXT, bgcolor=bgc, text_size=txs)
                table.cell(tList, 6, row, p.ebar >= 0 ? "T+" + str.tostring(p.ebar - p.tbar) + " " + px(p.epx) : "-", text_color=C_TXT, bgcolor=bgc, text_size=txs)
                table.cell(tList, 7, row, p.xbar >= 0 ? "T+" + str.tostring(p.xbar - p.tbar) + " " + p.reason : "-", text_color=C_TXT, bgcolor=bgc, text_size=txs)
                table.cell(tList, 8, row, tradePb ? pct(pn) : "-", text_color=C_TXT, bgcolor=bgc, text_size=txs)
                table.cell(tList, 9, row, pct(p.bnet6), text_color=C_TXT, bgcolor=bgc, text_size=txs)
                float d = pn - p.bnet6
                table.cell(tList, 10, row, tradePb ? pct(d) : "-", text_color=C_TXT, bgcolor=not tradePb or na(d) ? bgc : (d > 0.0005 ? C_GOOD : (d < -0.0005 ? C_BAD : bgc)), text_size=txs)
                table.cell(tList, 11, row, p.verdict, text_color=C_TXT, bgcolor=bgc, text_size=txs, tooltip=p.note)
                shown += 1
        table.cell(tList, 1, shown + 1, "page " + str.tostring(iPage) + " of " + str.tostring(math.max(1, int(math.ceil(nk / float(iRows))))) + ", " + str.tostring(nk) + " picks", text_color=C_TXT, bgcolor=C_HEAD, text_size=txs, text_halign=text.align_left)
    // ---------------------------------------------------------------- the focus pick
    table.clear(tFoc, 0, 0, 1, 17)
    if focusIdx >= 0
        Pick p = picks.get(focusIdx)
        int q = p.pb - 1
        array<string> ks = array.from("Pick", "Category", "Playbook", "Rule", "Level / order", "Status", "Entry", "Stop / target", "Exit", "Playbook net", "OPEN6", "Difference", "PLAN5", "TradingView net", "Data", "Verdict", "Note")
        array<string> vs = array.new_string()
        vs.push("#" + str.tostring(p.num) + " " + p.id + " (T " + str.tostring(p.ymd) + ")")
        vs.push(p.cat + " age " + str.tostring(p.age) + ", regime " + p.rg)
        vs.push("P" + str.tostring(p.pb) + ": " + aN.get(q))
        vs.push(pbDesc(q))
        vs.push("level " + px(p.lvl) + "  trigger " + px(p.trig) + "  limit " + px(p.lim) + (not na(p.wpx) ? "  last working " + px(p.wpx) : ""))
        vs.push(stName(p) + (p.why != "" ? " (" + p.why + ")" : ""))
        vs.push(p.ebar >= 0 ? "T+" + str.tostring(p.ebar - p.tbar) + " @ " + px(p.epx) + " (" + p.how + ")" : "-")
        vs.push(px(p.stop0) + " / " + px(p.tgt) + (p.armed ? "  trail armed, last stop " + px(p.stop) : ""))
        vs.push(p.xbar >= 0 ? "T+" + str.tostring(p.xbar - p.tbar) + " @ " + px(p.xpx) + " " + p.reason : "-")
        vs.push(pct(pbNet(p)))
        vs.push("T+1 open " + px(p.bE) + " -> T+6 open " + px(p.b6) + "  " + pct(p.bnet6))
        vs.push(pct(pbNet(p) - p.bnet6))
        vs.push(pct(p.bnet5))
        vs.push(pct(p.tvnet))
        vs.push("chart / cache price " + (na(p.scale) ? "-" : str.tostring(p.scale, "0.0000")) + "; OPEN6 gross chart " + pct(p.bg6) + " vs cache " + pct(p.g6))
        vs.push(p.verdict)
        vs.push(p.note)
        table.cell(tFoc, 0, 0, "Focus", text_color=C_TXT, bgcolor=C_HEAD, text_size=txs)
        table.cell(tFoc, 1, 0, "blue = T, yellow = order working, green = in the trade", text_color=C_TXT, bgcolor=C_HEAD, text_size=txs, text_halign=text.align_left)
        for r = 0 to ks.size() - 1
            table.cell(tFoc, 0, r + 1, ks.get(r), text_color=C_TXT, bgcolor=C_CELL, text_size=txs, text_halign=text.align_left)
            table.cell(tFoc, 1, r + 1, vs.get(r), text_color=C_TXT, bgcolor=C_CELL, text_size=txs, text_halign=text.align_left)
    else if iFocus > 0 or iFocusId != ""
        table.cell(tFoc, 0, 0, "Focus", text_color=C_TXT, bgcolor=C_HEAD, text_size=txs)
        table.cell(tFoc, 1, 0, "no shown pick has that number / id", text_color=C_TXT, bgcolor=C_BAD, text_size=txs)
